import ../../../ui/source_language.dl

to get [a source server request] {a pointer to JSON value:id} [named] {string:method}:
    return a JSON object containing [JSON text "jsonrpc" is "2.0", JSON child "id" is id, JSON text "method" is method, JSON child "params" is (a new JSON-RPC object)]

set document to a UI source document named "main.dl" at "file:///workspace/main.dl" prefixed by "" containing "value means: 7" using UI CPU analysis
set client to a UI language client rooted at "file:///workspace"
set client's phase to 7
set client's opened to true
set client's document to document
set client's uri to document's uri
set client's context to document's context
set client's profiles to the compact JSON form of (document's profiles)
set client's snapshot to document's source
set client's revision to document's revision
set client's version to 1
set document's analyzed revision to document's revision

# JSON-RPC request identifiers belong to independent directions. The server's
# request deliberately has the same identifier as the editor's hover request.
set query to request UI source feature "textDocument/hover" at byte 0 in document
set work to the next UI language work for client analyzing document at 0.0 seconds
free work's payload
set response to a JSON array containing [
    a source server request (a new JSON-RPC integer for 12) named "workspace/semanticTokens/refresh",
    a JSON object containing [JSON number "id" is 12, JSON child "result" is (a new JSON-RPC text for "The inferred type")]
]
set work to the UI language reply response at step 12 in client
free response
require condition ((query's ready) and (query's result's text = "The inferred type")) reporting "A server request with a matching ID was mistaken for a source feature result."
require condition (work's step = 13) reporting "A semantic refresh request was not acknowledged."
set message to the JSON member named "message" in (work's payload)
require condition (((the JSON number named "id" in message) = 12.0) and ((the JSON member named "result" in message)'s kind = the JSON null kind)) reporting "The semantic refresh acknowledgement lost its ID or result."
free work's payload
set response to a new JSON-RPC array
set work to the UI language reply response at step 13 in client
free response
require condition ((work's step = 0) and (client's phase = 7)) reporting "Acknowledging a request did not restore the suspended editor state."
require condition ((document's revision = 1) and (document's analyzed revision = 1)) reporting "A semantic refresh changed the source revision."
set work to the next UI language work for client analyzing document at 0.0 seconds
require condition ((work's step = 6) and (client's version = 1)) reporting "A semantic refresh failed to request new tokens without resending unchanged text."
free work's payload

# Replies arriving with the token result must be drained in order, including
# further requests received while an acknowledgement itself is in flight.
set response to a JSON array containing [
    a source server request (a new JSON-RPC text for "server-😀") named "example/unsupported",
    a JSON object containing [JSON number "id" is 6, JSON child "result" is (a JSON object containing [JSON child "data" is (a new JSON-RPC array)])]
]
set work to the UI language reply response at step 6 in client
free response
require condition (work's step = 13) reporting "An unsupported server request was left unanswered."
set message to the JSON member named "message" in (work's payload)
require condition (((the JSON text named "id" in message) = "server-😀") and ((the JSON number named "code" in (the JSON member named "error" in message)) = -32601.0)) reporting "An unsupported request lost its string ID or method-not-found response."
free work's payload
set response to a JSON array containing [a source server request (a new JSON-RPC integer from "9007199254740993") named "workspace/semanticTokens/refresh"]
set work to the UI language reply response at step 13 in client
free response
require condition (work's step = 13) reporting "A server request arriving during acknowledgement was discarded."
set message to the JSON member named "message" in (work's payload)
require condition ((the compact JSON form of (the JSON member named "id" in message)) = "9007199254740993") reporting "A server request ID was rounded through floating-point storage."
free work's payload
set response to a new JSON-RPC array
set work to the UI language reply response at step 13 in client
free response
set work to the next UI language work for client analyzing document at 0.0 seconds
require condition (work's step = 6) reporting "A later refresh was concealed by an earlier token result."
free work's payload
set generation to document's token generation
set response to a JSON array containing [a JSON object containing [JSON number "id" is 6, JSON child "result" is (a JSON object containing [JSON child "data" is (a new JSON-RPC array)])]]
set work to the UI language reply response at step 6 in client
free response
require condition (document's token generation = generation) reporting "An identical semantic-token response invalidated unchanged colors."

# An acknowledgement can suspend real outgoing work, not only an idle state.
set client's phase to 4
set response to a JSON array containing [a source server request (a new JSON-RPC integer for 20) named "workspace/semanticTokens/refresh"]
set work to the UI language reply response at step 4 in client
free response
require condition (work's step = 13) reporting "Document opening did not service the server's request first."
free work's payload
set response to a new JSON-RPC array
set work to the UI language reply response at step 13 in client
free response
require condition ((work's step = 6) and (client's phase = 6)) reporting "The pending token request was lost while replying to the server."
free work's payload

# Closing while real work is suspended must release the queued payload too.
set client's phase to 4
set response to a JSON array containing [a source server request (a new JSON-RPC integer for 21) named "workspace/semanticTokens/refresh"]
set work to the UI language reply response at step 4 in client
free response
free work's payload
free UI language client client
free UI source document document
print line "Source language requests are bidirectional, preserve continuations and refresh unchanged semantic colors."
