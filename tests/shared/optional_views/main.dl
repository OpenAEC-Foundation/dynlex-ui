import ../../../testing/driver.dl
import ../../../ui/key_bindings.dl

appearance stack appearance:
    gap is 12
    padding is 10

appearance editor appearance:
    height is 80

document conditional views using stack appearance:
    button "Before"
    view group "Details" using stack appearance:
        region "Work" using stack appearance:
            button "Run"
            text surface "Draft" containing "kept draft" using editor appearance
            paragraph "Retained explanation" using no UI appearance
            choice field "Mode" choosing "One" using no UI appearance:
                choice "One"
                choice "Two"
        region "Information" using stack appearance:
            paragraph "Other view" using no UI appearance
    button "After"

to [record a conditional action] {a pointer to UI instance:instance}:
    increment the value at (instance's state as a pointer to integer)

set count to 0
set instance to an instance of conditional views with state (the address of count)
set window to the address of instance
set view to a UI view of window sized 500 by 400 using font "regular" with the test UI driver
set group to the control labeled "Details" in window
set source to the control labeled "Draft" in window
set button to the control labeled "Run" in window
bind button in window to (the function named "record a conditional action $") for event 0
bind UI key 257 with modifiers 2 from conditional views in window activating button
set value to the UI value for source in window
ignore record UI text edit in (the address of (value's text state)) replacing with (the string form of "edited draft") from 0 through 0 selecting 12 through 12
set history to value's undo
ignore update UI view (the address of view)
set before to the UI layout labeled "Before" in (view's layout)
set after to the UI layout labeled "After" in (view's layout)
set run to the UI layout labeled "Run" in (view's layout)
set position to a UI point at (run's painted bounds' x + 5.0) and (run's painted bounds' y + 5.0)
set glyph to view's texts
loop while glyph's source != (the address of ((the UI layout labeled "Draft" in (view's layout))'s text source)):
    set glyph to glyph's next
set point to a UI point at (glyph's origin's x + 2.0) and (glyph's origin's y - 2.0)
require condition ((the UI text hit at point in (the address of view)) = glyph) reporting "The visible draft did not expose its text hit target"
select UI text at point in glyph extending false in (the address of view)
set explanation to the UI layout labeled "Retained explanation" in (view's layout)
set caption to view's texts
loop while caption's source != (the address of (explanation's text source)):
    set caption to caption's next
set {caption point} to a UI point at (caption's origin's x + 2.0) and (caption's origin's y - 2.0)

set the value of "Details" in window to -1
require condition ((the UI text hit at point in (the address of view)) = (0 as a pointer to UI text run)) reporting "Hidden editor glyphs remained selectable before repainting"
require condition ((the UI text hit at caption point in (the address of view)) = (0 as a pointer to UI text run)) reporting "Hidden paragraph glyphs remained selectable before repainting"
require condition ((the nearest UI text to point in (the address of view)) = (0 as a pointer to UI text run)) reporting "A selection drag could enter hidden text"
require condition ((the selected UI child of group in window) = (0 as UI reference)) reporting "An optional view group cannot select no view"
require condition ((the active UI editor within group in window) = (0 as UI reference)) reporting "A hidden view still exposes its editor"
set hit to the UI hit at position in (the address of view)
require condition (hit != run) reporting "A newly hidden view retained its previous pointer target before repainting"
ignore deliver UI input of kind 3 key 257 at 0.0 0.0 with modifiers 2 containing "" in (the address of view)
require condition (count = 0) reporting "A keyboard command activated a hidden view's control"
ignore update UI view (the address of view)
require condition (after's bounds' y = before's bounds' y + before's bounds' height + 12.0) reporting "A hidden view retained its padding or inter-item spacing"
require condition (view's control count = 2) reporting "A hidden view retained keyboard focus stops"

set the value of "Details" in window to 0
ignore update UI view (the address of view)
require condition ((value's text = "edited draft") and (value's undo = history)) reporting "Showing a view replaced its retained editor draft or undo history"
set the value of "Details" in window to 1
set hit to the UI hit at position in (the address of view)
require condition (hit != run) reporting "Switching views kept the old view's pointer target until the next paint"
ignore update UI view (the address of view)
require condition (view's control count = 2) reporting "An inactive view retained keyboard focus stops"
set the value of "Details" in window to 0
ignore update UI view (the address of view)
ignore deliver UI input of kind 3 key 257 at 0.0 0.0 with modifiers 2 containing "" in (the address of view)
require condition (count = 1) reporting "Showing a view did not restore its bound action"
set choice to the UI layout labeled "Mode" in (view's layout)
activate UI layout choice in (the address of view)
require condition (view's popup = choice) reporting "The visible conditional choice field did not open"
set the value of "Details" in window to -1
ignore deliver UI input of kind 3 key 264 at 0.0 0.0 with modifiers 0 containing "" in (the address of view)
ignore deliver UI input of kind 3 key 257 at 0.0 0.0 with modifiers 0 containing "" in (the address of view)
require condition (view's popup = (0 as a pointer to UI layout)) reporting "Hiding a choice field retained its open menu"
require condition ((the value of "Mode" in window) = 0) reporting "A hidden menu changed its owner's selected value"
close the address of view
close window
print line "Optional views collapse layout, reject hidden pointer and keyboard actions, and retain editor state when shown again."
