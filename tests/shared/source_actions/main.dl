import ../../helpers/driver.dl
import ../../../ui/source_tools.dl
import ../../../ui/source_panes.dl

document editors:
    source pane "Studio" containing "😀 alpha\nbeta" using no UI appearance
    source pane "River" containing "😀 alpha\nbeta" using no UI appearance

to [answer action query] {a pointer to UI source query:query} [with] {a pointer to JSON value:result}:
    free query's result
    set query's result to result
    set query's queued to false
    set query's ready to true

set instance to an instance of editors
set window to the address of instance
set view to a UI view of window sized 900 by 900 using font "regular" with the test UI driver
set workspace to a UI source workspace in window rooted at "file:///workspace"
enable UI source tools for workspace in (the address of view)
ignore update UI view (the address of view)
set labels to ["Studio", "River"]
set index to 0
loop while index < the length of labels:
    set editor to the UI source editor labeled (the item at index in labels) in workspace
    set document to editor's document
    set original to document's source
    set prefix to (the string form of "# hidden\n") if (index = 0), else (the string form of "import lib/river_challenge.dl\n\n")
    set row to 1 if (index = 0), else 2
    set files to a new JSON-RPC object
    configure UI source document document named "main.dl" at "file:///workspace/main.dl" prefixed by prefix using UI CPU analysis with files files
    free files
    free document's diagnostics
    set problem to a JSON object containing [JSON text "message" is "Replace alpha", JSON child "range" is (an LSP range from line row and character 3 to line row and character 8), JSON child "data" is (a JSON object containing [JSON text "marker" is "keep opaque diagnostic data"])]
    set unrelated to a JSON object containing [JSON text "message" is "Elsewhere", JSON child "range" is (an LSP range from line (row + 1) and character 0 to line (row + 1) and character 4)]
    set hidden to a JSON object containing [JSON text "message" is "Protected context", JSON child "range" is (an LSP range from line 0 and character 0 to line 0 and character 1)]
    set document's diagnostics to a JSON array containing [problem, unrelated, hidden]
    set document's diagnostic revision to document's revision
    set document's diagnostic project revision to document's project's revision
    restore UI source location (editor's current) in editor in (the address of view)
    set view's selection's anchor and view's selection's caret to 8
    update UI source tools in workspace
    if index = 0:
        queue UI input of kind 3 key 296 at 0.0 0.0 with modifiers 0 containing "" in (the address of view)
        process UI input in (the address of view)
    else:
        activate (editor's fixes) belonging to (editor's fixes) in window
    set tools to workspace's tools
    set query to tools's query
    require condition (query != @intrinsic("construct", a pointer to UI source query)) reporting "The fixes action did not request code actions."
    require condition (query's method = "textDocument/codeAction") reporting "Quick fixes did not use the shared language client."
    set range to the JSON member named "range" in (query's parameters)
    require condition (((the JSON number named "line" in (the JSON member named "start" in range)) = (row as a floating-point number)) and ((the JSON number named "character" in (the JSON member named "start" in range)) = 6.0)) reporting "A quick-fix request ignored Unicode or hidden context."
    set diagnostics to the JSON member named "diagnostics" in (the JSON member named "context" in (query's parameters))
    require condition (diagnostics's length = 1) reporting "Quick fixes included diagnostics outside their visible selection."
    require condition ((the JSON text named "marker" in (the JSON member named "data" in (the JSON value at index 0 in diagnostics))) = "keep opaque diagnostic data") reporting "Quick fixes discarded the compiler's diagnostic payload."
    set edit to a JSON object containing [JSON child "range" is (an LSP range from line row and character 3 to line row and character 8), JSON text "newText" is "A"]
    set action to a JSON object containing [JSON text "title" is "Replace alpha", JSON child "edit" is (a JSON object containing [JSON child "changes" is (a JSON object containing [JSON child (document's uri) is (a JSON array containing [edit])])])]
    set disabled to a JSON object containing [JSON text "title" is "Unavailable fix", JSON child "disabled" is (a JSON object containing [JSON text "reason" is "Not writable"])]
    answer action query query with (a JSON array containing [disabled, action])
    update UI source tools in workspace
    ignore update UI view (the address of view)
    require condition ((tools's choices' count = 2) and (tools's choices' selected = 1)) reporting "Quick fixes did not share disabled-row selection."
    queue UI input of kind 3 key 257 at 0.0 0.0 with modifiers 0 containing "" in (the address of view)
    process UI input in (the address of view)
    require condition ((document's source = "😀 A\nbeta") and (view's selection's caret = 6)) reporting "A quick fix did not apply its mapped text edit."
    set value to the UI value for (editor's node) in window
    require condition ((value's undo != @intrinsic("construct", a pointer to UI text edit)) and (value's undo's next = @intrinsic("construct", a pointer to UI text edit))) reporting "A quick fix was not one undoable action."
    queue UI input of kind 3 key 90 at 0.0 0.0 with modifiers 2 containing "" in (the address of view)
    ignore update UI view (the address of view)
    synchronize UI source workspace workspace at 2.0 seconds
    require condition (document's source = original) reporting "A quick fix could not be undone."
    queue UI input of kind 3 key 296 at 0.0 0.0 with modifiers 0 containing "" in (the address of view)
    process UI input in (the address of view)
    set query to tools's query
    set UI text of (editor's node) in window to "new source"
    synchronize UI source workspace workspace at 3.0 seconds
    answer action query query with (a new JSON-RPC array)
    update UI source tools in workspace
    require condition ((tools's mode = 0) and (value's text = "new source")) reporting "An obsolete quick-fix reply replaced a newer source."
    set UI control (editor's node) read only true in window
    queue UI input of kind 3 key 296 at 0.0 0.0 with modifiers 0 containing "" in (the address of view)
    process UI input in (the address of view)
    require condition (tools's mode = 0) reporting "An application read-only source offered a modifying quick fix."
    increment index
# Open fixes before the analysis barrier publishes this revision's diagnostics.
set UI control (editor's node) read only false in window
load UI main source of editor in (the address of view) from original at 4.0 seconds
set document's diagnostic revision to 0
set view's selection's anchor and view's selection's caret to 8
update UI source tools in workspace
queue UI input of kind 3 key 296 at 0.0 0.0 with modifiers 0 containing "" in (the address of view)
process UI input in (the address of view)
set document's diagnostic revision to document's revision
set document's diagnostic project revision to document's project's revision
set client to workspace's client
set client's model to the UI language model for document in client
set client's project to document's project
set client's phase to 7
set client's opened to true
set client's uri to document's uri
set client's context to document's context
set client's project context to document's project's context
set client's project revision to document's project's revision
set client's profiles to the compact JSON form of (document's project's profiles)
set client's snapshot to document's prefix + document's source
set client's revision to document's revision
set client's version to 1
set document's analyzed revision to document's revision
set document's analyzed project revision to document's project's revision
set document's analyzed token epoch to document's token epoch
set work to the next UI language work for client analyzing document at 4.0 seconds
require condition (work's step = 12) reporting "The completed analysis did not dispatch its pending fixes request."
set parameters to the JSON member named "params" in (the JSON member named "message" in (work's payload))
set diagnostics to the JSON member named "diagnostics" in (the JSON member named "context" in parameters)
require condition (diagnostics's length = 1) reporting "A fixes request froze diagnostics before its analysis completed."
free work's payload
free UI source workspace workspace
close the address of view
close window
print line "Studio and River share diagnostic quick fixes, protected Unicode ranges, disabled actions, undo and stale-result rejection."
