import ../../helpers/driver.dl
import ../../../ui/source_tools.dl
import lib/text_scan.dl

document editors:
    editor "Studio" containing "get" using no UI appearance
    editor "River" containing "get" using no UI appearance

set instance to an instance of editors
set window to the address of instance
set view to a UI view of window sized 900 by 600 using font "regular" with the test UI driver
set workspace to a UI source workspace in window rooted at "file:///workspace"
enable UI source tools for workspace in (the address of view)
ignore update UI view (the address of view)
set labels to ["Studio", "River"]
set index to 0
loop while index < the length of labels:
    set editor to the UI source editor labeled (the item at index in labels) in workspace
    set prefix to (the string form of "") if (index = 0), else (the string form of "import lib/river_challenge.dl\n\n")
    set files to a new JSON-RPC object
    configure UI source document (editor's document) named "main.dl" at "file:///workspace/main.dl" prefixed by prefix using UI CPU analysis with files files
    free files
    set layout to the UI layout for element (editor's node) in (view's layout)
    set view's keyboard focus to true
    set view's focus order to layout's order
    refresh UI focus in (the address of view)
    set view's text focus to editor's node
    set view's selection's caret source to the address of (layout's text source)
    set view's selection's anchor source to view's selection's caret source
    set view's selection's caret to 3
    set view's selection's anchor to 3
    queue UI input of kind 3 key 32 at 0.0 0.0 with modifiers 2 containing "" in (the address of view)
    process UI input in (the address of view)
    set query to workspace's tools' query
    require condition (query's queued) reporting "An editor did not request shared completion."
    set row to 0 if (index = 0), else 2
    set edit to a JSON object containing [JSON child "range" is (an LSP range from line row and character 0 to line row and character 3), JSON text "newText" is "get the "]
    set item to a JSON object containing [JSON text "label" is "get the ", JSON child "textEdit" is edit, JSON child "command" is (a JSON object containing [JSON text "command" is "editor.action.triggerSuggest"])]
    free query's result
    set query's result to a JSON object containing [JSON child "items" is (a JSON array containing [item])]
    set query's queued to false
    set query's ready to true
    update UI source tools in workspace
    ignore update UI view (the address of view)
    set surface to view's window as a pointer to test UI surface
    require condition (surface's drawn contains "↑ ↓ choose") reporting "The shared source popup was not rendered."
    require condition (workspace's tools' choices' rows = 1) reporting "The popup did not retain its visible item count."
    queue UI input of kind 3 key 257 at 0.0 0.0 with modifiers 0 containing "" in (the address of view)
    process UI input in (the address of view)
    set value to the UI value for (editor's node) in window
    require condition (value's text = "get the ") reporting "Completion did not replace the shared editor source."
    require condition (view's selection's caret = 8) reporting "Completion did not place the caret after its edit."
    require condition ((value's undo != @intrinsic("construct", a pointer to UI text edit)) and (value's undo's next = @intrinsic("construct", a pointer to UI text edit))) reporting "Completion was not one undoable edit."
    require condition ((workspace's tools' query's queued) and (workspace's tools' query's revision = editor's document's revision)) reporting "The completion command did not request suggestions for the edited source."
    require condition (editor's document's prefix = prefix) reporting "Completion modified the editor's hidden context."
    queue UI input of kind 3 key 256 at 0.0 0.0 with modifiers 0 containing "" in (the address of view)
    process UI input in (the address of view)
    require condition ((workspace's tools' mode = 0) and (view's closed = false)) reporting "Dismissing suggestions closed the window."
    increment index
set node to the control labeled "River" in window
set UI control node read only true in window
queue UI input of kind 3 key 32 at 0.0 0.0 with modifiers 2 containing "" in (the address of view)
process UI input in (the address of view)
require condition (workspace's tools' mode = 0) reporting "A read-only source offered a modifying completion."
free UI source workspace workspace
require condition (view's overlays = @intrinsic("construct", a pointer to UI overlay)) reporting "A source workspace leaked its view overlay."
close the address of view
close window
print line "Studio and embedded editors share completion, commands, undo, input capture and protected context."
