import ../../../testing/driver.dl
import ../../../ui/source_buffers.dl

document editors:
    editor "Studio" containing "abc" using no UI appearance
    editor "River" containing "row" using no UI appearance
    read only editor "Locked" containing "fixed" using no UI appearance

set instance to an instance of editors
set window to the address of instance
set view to a UI view of window sized 900 by 900 using font "regular" with the test UI driver
set workspace to a UI source workspace in window rooted at "file:///workspace"
ignore update UI view (the address of view)
set labels to ["Studio", "River", "Locked"]
set index to 0
loop while index < the length of labels:
    set editor to the UI source editor labeled (the item at index in labels) in workspace
    set node to editor's node
    set main to editor's document
    set original to main's source
    set imported to a UI source document named "helper.dl" at "file:///lib/helper.dl" containing "# helper" in (main's project)
    restore UI source location (editor's current) in editor in (the address of view)
    set UI control node read only true in window
    visit UI source document imported selecting 0 through 0 in editor in (the address of view)
    ignore go back in UI source editor editor in (the address of view)
    require condition ((the UI element node accepts edits in window) = false) reporting "Definition navigation discarded the application's read-only policy."
    queue UI input of kind 4 key 0 at 0.0 0.0 with modifiers 0 containing "blocked" in (the address of view)
    ignore update UI view (the address of view)
    require condition ((the UI value for node in window)'s text = main's source) reporting "Returning from an import allowed a protected source to change."
    set UI control node read only false in window
    visit UI source document imported selecting 0 through 0 in editor in (the address of view)
    set UI control node read only false in window
    require condition ((the UI element node accepts edits in window) = false) reporting "Changing application policy made an imported source writable."
    ignore go back in UI source editor editor in (the address of view)
    require condition (the UI element node accepts edits in window) reporting "Definition navigation restored an obsolete read-only policy."
    queue UI input of kind 4 key 0 at 0.0 0.0 with modifiers 0 containing "!" in (the address of view)
    ignore update UI view (the address of view)
    synchronize UI source workspace workspace at 1.0 seconds
    require condition (main's source = ("!" + original)) reporting "The unlocked main source did not accept input."
    visit UI source document imported selecting 0 through 0 in editor in (the address of view)
    set UI control node read only true in window
    ignore go back in UI source editor editor in (the address of view)
    require condition ((the UI element node accepts edits in window) = false) reporting "A policy set while visiting an import was lost on return."
    increment index
free UI source workspace workspace
close the address of view
close window
print line "Application read-only policy survives source navigation while imported documents remain protected."
