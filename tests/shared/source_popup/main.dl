import ../../helpers/driver.dl
import ../../../ui/source_tools.dl

to [inspect popup triangles in] {a pointer to UI view:view} [vertices] {a pointer to UI vertex:vertices} [counting] {integer:count} [with] {a pointer:texture}:
    if the value at (view's instance's state as a pointer to a boolean):
        set index to 0
        loop while index < count:
            set vertex to the item at index in vertices
            if vertex's alpha > 0.99:
                require condition ((vertex's red < 0.5) and ((vertex's green < 0.5) and (vertex's blue < 0.5))) reporting "A source popup ignored the editor's dark surface."
            increment index
    submit test UI view vertices vertices counting count with texture

appearance source appearance:
    font size is 32
    height is 180
    padding is 12
    background is UI ink 16 24 32
    text is UI ink 220 230 240

document example:
    editor "Source" containing "a\nb\nc\nd\ne\nf" using source appearance
    link "Run" to "action:run" using no UI appearance

set inspecting to false
set instance to an instance of example with state (the address of inspecting)
set window to the address of instance
set driver to the value at the test UI driver
set driver's triangles to (the function named "inspect popup triangles in $ vertices $ counting $ with $") as a pointer
set view to a UI view of window sized 900 by 600 using font "regular" with (the address of driver)
set workspace to a UI source workspace in window rooted at "file:///workspace"
enable UI source tools for workspace in (the address of view)
ignore update UI view (the address of view)
queue UI input of kind 3 key 258 at 0.0 0.0 with modifiers 0 containing "" in (the address of view)
ignore update UI view (the address of view)
queue UI input of kind 3 key 32 at 0.0 0.0 with modifiers 2 containing "" in (the address of view)
process UI input in (the address of view)
set tools to workspace's tools
free tools's items
set tools's items to a new JSON-RPC array
set index to 0
loop while index < 9:
    add (a JSON object containing [JSON text "label" is "suggestion"]) to the JSON array (tools's items)
    increment index
set tools's query's ready to true
set inspecting to true
paint UI source tools (tools as a pointer) on (@intrinsic("construct", UI frame, the address of view, true))
set inspecting to false
set layout to the UI layout for element (tools's node) in (view's layout)
set box to tools's bounds
set clip to layout's hit bounds
require condition (tools's row height >= 32.0) reporting "Suggestion rows clipped their editor's font size."
require condition ((box's x >= clip's x) and ((box's x + box's width) <= (clip's x + clip's width))) reporting "A source popup extended horizontally beyond its editor."
require condition ((box's y >= clip's y) and ((box's y + box's height) <= (clip's y + clip's height))) reporting "A source popup covered actions outside its editor."
set layout's hit bounds' height to 40.0
set view's height to 40
paint UI source tools (tools as a pointer) on (@intrinsic("construct", UI frame, the address of view, true))
set text to (the UI value for (tools's node) in window)'s text
queue UI input of kind 3 key 257 at 0.0 0.0 with modifiers 0 containing "" in (the address of view)
process UI input in (the address of view)
require condition ((the UI value for (tools's node) in window)'s text = (text + "\n")) reporting "An invisible popup inserted a suggestion."
free UI source workspace workspace
close the address of view
close window
print line "Source popups inherit their editor surface, stay within it and require visible rows to insert."
