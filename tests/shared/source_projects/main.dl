import ../../../ui/source_queries.dl

set main to a UI source document named "main.dl" at "file:///workspace/main.dl" prefixed by "# hidden\n" containing "import helper.dl\nprint line helper" using UI CPU analysis
set files to a JSON object containing [JSON text "helper.dl" is "helper means: 7"]
configure UI source document main named "main.dl" at "file:///workspace/main.dl" prefixed by "# hidden\n" using UI CPU analysis with files files
free files
set project to main's project
require condition (project's entry = main) reporting "A source project lost its main document."
set helper to a UI source document named "helper.dl" at "file:///workspace/helper.dl" containing "helper means: 7" in project
require condition (helper's project = project) reporting "An imported document became an independent project."
require condition ((helper's project's profiles = main's project's profiles) and (helper's project's files = main's project's files)) reporting "Imported documents copied or lost their shared project configuration."
require condition (((the JSON text named "helper.dl" in (helper's project's files)) = "helper means: 7") and (helper's prefix = "")) reporting "The main document's hidden prefix leaked into an imported document."
require condition ((main's writable) and (helper's writable = false)) reporting "Imported code did not have a separate read-only policy."
require condition ((the UI source document at "file:///workspace/main.dl" in project) = main) reporting "The main source was absent from its project models."
require condition ((the UI source document at "file:///workspace/helper.dl" in project) = helper) reporting "A project could not retain its imported model by URI."
require condition ((the UI source document at "file:///workspace/missing.dl" in project) = @intrinsic("construct", a pointer to UI source document)) reporting "Looking up an unknown source fabricated a model."

set helper's analyzed revision to helper's revision
set helper's analyzed project revision to project's revision
require condition ((helper needs UI source analysis) = false) reporting "An unchanged imported model was always dirty."
set query to request UI source feature "textDocument/hover" at byte 0 in helper
set revision to helper's revision
edit UI source document main to (the string form of "import helper.dl\nprint line helper + 1") at 1.0 seconds
require condition ((helper's revision = revision) and (helper's source = "helper means: 7")) reporting "Editing the main file forged an edit in an imported file."
require condition ((query is current for UI source document helper) = false) reporting "An imported-file query survived a change to its main project source."
require condition (query's queued = false) reporting "A project edit left obsolete imported-file work queued."
require condition (helper needs UI source analysis) reporting "A main-file edit did not invalidate imported semantic results."

set query to request UI source feature "textDocument/definition" at byte 0 in helper
set files to a JSON object containing [JSON text "helper.dl" is "helper means: 9"]
configure UI source document main named "renamed.dl" at "file:///workspace/renamed.dl" prefixed by "# different hidden context\n" using UI CPU analysis with files files
free files
require condition ((helper's project = project) and (project's entry = main)) reporting "Reconfiguring a project detached its retained imported models."
require condition (((the JSON text named "helper.dl" in (helper's project's files)) = "helper means: 9") and (helper's prefix = "")) reporting "An imported model retained copied project files or inherited the hidden prefix."
require condition ((query is current for UI source document helper) = false) reporting "An imported-file query retained an obsolete project configuration."
require condition ((query's queued = false) and ((helper's revision = revision + 1) and (helper's source = "helper means: 9"))) reporting "Project reconfiguration queued stale work or retained replaced imported source."
require condition ((the UI source document at "file:///workspace/main.dl" in project) = @intrinsic("construct", a pointer to UI source document)) reporting "Renaming the main file retained its former URI as another model."
require condition ((the UI source document at "file:///workspace/renamed.dl" in project) = main) reporting "Renaming the main file lost its model identity."

# Root ownership includes imported models and their retained query slots. The
# Wasm allocation probe checks that closing this project releases all of them.
free UI source project (main's project)
print line "Source projects retain shared metadata and imported models while invalidating queries without forging file edits."
