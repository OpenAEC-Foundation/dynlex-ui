import ../../../ui/source_workspace.dl
import ../../../ui/document_declarations.dl
import ../../../ui/document_layout.dl
import ../../../ui/layout.dl

document example:
    page "First":
        tab group "Modes" using no UI appearance:
            tab "Program":
                editor "Plain source" containing "print line 7" using no UI appearance
            tab "Game":
                editor "Game source" containing "move right" using no UI appearance
                paragraph "Game problems" containing "" using no UI appearance
                paragraph "Game analysis" containing "" using no UI appearance
    page "Other":
        editor "Other source" containing "print line 8" using no UI appearance

set instance to an instance of example
set window to the address of instance
show page "First" in window
set workspace to a UI source workspace in window rooted at "file:///workspace"
set plain to the UI source editor labeled "Plain source" in workspace
set game to the UI source editor labeled "Game source" in workspace
set other to the UI source editor labeled "Other source" in workspace
set files to a new JSON-RPC object
configure UI source document (game's document) named "game.dl" at "file:///workspace/game.dl" prefixed by "import game.dl\n\n" using UI CPU analysis with files files
free files
set work to the next UI source workspace work in workspace focused on (other's node) at 0.0 seconds
require condition ((work's step = 1) and (workspace's client's document = plain's document)) reporting "Hidden editors were analyzed before the active source."
free work's payload
set workspace's client's phase to 7
set workspace's client's opened to true
set plain's document's analyzed revision to plain's document's revision
set work to the next UI source workspace work in workspace focused on (plain's node) at 1.0 seconds
require condition (work's step = 0) reporting "Unchanged or inactive sources were reanalyzed."
set the value of "Modes" in window to 1
set work to the next UI source workspace work in workspace focused on (plain's node) at 2.0 seconds
require condition ((work's step = 9) and (workspace's client's desired = game's document)) reporting "A selected game editor did not share the workspace."
free work's payload
set the text of "Game source" in window to "move left"
synchronize UI source workspace workspace at 3.0 seconds
require condition ((game's document's source = "move left") and (game's document's revision = 3)) reporting "Programmatic edits did not invalidate shared language state."
require condition (game's document's prefix = "import game.dl\n\n") reporting "Synchronizing an editor discarded its project context."
set view to a new UI view
set view's instance to window
set view's layout to a document UI layout for (window's description) inside (window's description)
set view's paint count to 1
set view's text focus to other's node
set layout to the UI layout for element (game's node) in (view's layout)
set layout's paint generation to 1
set layout's hit bounds to UI box at 0 0 sized 200 100
require condition ((the UI source focus in (the address of view) for workspace) = game's node) reporting "Viewport priority followed a focused editor in an inactive page."
set view's text focus to game's node
set layout's hit bounds to UI box at 0 0 sized 0 0
require condition ((the UI source focus in (the address of view) for workspace) = game's node) reporting "A focused source lost priority while scrolled."
set files to a JSON object containing [JSON text "helper.dl" is "helper means: 1"]
configure UI source document (game's document) named "game.dl" at "file:///workspace/game.dl" prefixed by "import game.dl\n\n" using UI CPU analysis with files files
free files
configure UI source document (game's document) named "game.dl" at "file:///workspace/game.dl" prefixed by "import game.dl\n\n" using UI CPU analysis with files (game's document's project's files)
require condition ((the JSON text named "helper.dl" in (game's document's project's files)) = "helper means: 1") reporting "Reconfiguring a project freed borrowed files before copying them."
set game's diagnostics to the control labeled "Game problems" in window
set game's status to the control labeled "Game analysis" in window
set game's clean text to ""
set game's ready text to "Plan checked"
begin UI source reports for (game's document's project)
finish UI source reports for (game's document's project)
present UI source workspace workspace using (the default UI source token theme)
require condition (((the UI value for (game's diagnostics) in window)'s text = "") and ((the UI value for (game's status) in window)'s text = "Plan checked")) reporting "Embedded editors could not configure shared diagnostic presentation."
set reports to a JSON array containing [a JSON object containing [JSON text "message" is "Same source warning", JSON child "range" is (an LSP range from line 2 and character 0 to line 2 and character 4)]]
retain UI source diagnostics reports at (game's document's uri) in (game's document's project)
free reports
present UI source workspace workspace using (the default UI source token theme)
require condition ((the UI value for (game's status) in window)'s text = "1 problem") reporting "A new report for unchanged source did not refresh its diagnostic presentation."
set reports to a new JSON-RPC array
retain UI source diagnostics reports at (game's document's uri) in (game's document's project)
free reports
present UI source workspace workspace using (the default UI source token theme)
require condition ((the UI value for (game's status) in window)'s text = "Plan checked") reporting "Clearing a report for unchanged source left its preceding problem count visible."
set the text of "Game source" in window to "move upward"
synchronize UI source workspace workspace at 3.5 seconds
set diagnostic to a JSON object containing [
    JSON text "message" is "Unknown direction",
    JSON child "range" is (a JSON object containing [
        JSON child "start" is (an LSP position at line 2 and character 5),
        JSON child "end" is (an LSP position at line 2 and character 11)
    ])
]
begin UI source reports for (game's document's project)
set reports to a JSON array containing [diagnostic]
retain UI source diagnostics reports at (game's document's uri) in (game's document's project)
free reports
finish UI source reports for (game's document's project)
present UI source workspace workspace using (the default UI source token theme)
require condition ((the UI value for (game's status) in window)'s text = "1 problem") reporting "A single editor diagnostic used a plural problem count."
fail UI source workspace workspace
present UI source workspace workspace using (the default UI source token theme)
require condition ((the UI value for (game's status) in window)'s text = "An error occurred. Check the log.") reporting "A language transport failure was not visible in the embedded editor."
set the text of "Game source" in window to "edited after failure"
synchronize UI source workspace workspace at 4.0 seconds
present UI source workspace workspace using (the default UI source token theme)
require condition ((the UI value for (game's status) in window)'s text = "An error occurred. Check the log.") reporting "An edit concealed the failed transport behind an analyzing caption."
release UI layout (view's layout)
set main to game's document
set files to a JSON object containing [JSON text "helper.dl" is "helper means: 7"]
configure UI source document main named "game.dl" at (main's uri) prefixed by (main's prefix) using UI CPU analysis with files files
free files
set helper to a UI source document named "helper.dl" at "file:///workspace/helper.dl" containing "helper means: 7" in (main's project)
set game's document to helper
set UI control (game's node) read only true in window
synchronize UI source workspace workspace at 5.0 seconds
require condition (((the UI value for (game's node) in window)'s text = helper's source) and (main's source = "edited after failure")) reporting "Viewing an import overwrote its source with the main editor's preceding text."
set files to a JSON object containing [JSON text "helper.dl" is "helper means: 9"]
configure UI source document main named "game.dl" at (main's uri) prefixed by (main's prefix) using UI CPU analysis with files files
free files
synchronize UI source workspace workspace at 6.0 seconds
require condition ((helper's source = "helper means: 9") and ((the UI value for (game's node) in window)'s text = helper's source)) reporting "A read-only view overwrote replaced imported source with its preceding widget text."
free UI source workspace workspace
close window
print line "Source workspaces discover editors, follow selected views and synchronize programmatic edits."
