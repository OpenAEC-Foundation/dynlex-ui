import ../../ui/native.dl
import ../../examples/text/interface.dl

set instance to an instance of writing room
set view to a desktop view of (the address of instance) sized 960 by 640 using fonts "assets/fonts/NotoSans-Regular.ttf" and "assets/fonts/NotoSans-SemiBold.ttf"
run the address of view
print line (the UI value for (the control labeled "Project name" in (the address of instance)) in (the address of instance))'s text
close the address of view
close the address of instance
