import ../../ui/native.dl

window shared controls:
    heading "A shared UI engine"
    label "DynLex draws this on desktop and on a browser canvas."
    toolbar:
        button "Create"
        button "Open"
    switch "Reduced motion"

set state to 0
set instance to an instance of shared controls with state (the address of state)
set view to a desktop view of (the address of instance) sized 840 by 600 using fonts "assets/fonts/NotoSans-Regular.ttf" and "assets/fonts/NotoSans-SemiBold.ttf"
run the address of view
close the address of view
close the address of instance
