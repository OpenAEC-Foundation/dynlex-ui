import ../../ui/scene_shader.dl

if this is a vertex shader:
    set camera to the shader uniform named "scene_camera" at binding 0 as (@intrinsic("matrix", 4, 4, @intrinsic("type", "float", 32)))
    set clip to the UI scene shader clip position of (the UI scene shader world position) through camera
    set the output position with x (the element at 0 in clip), y (the element at 1 in clip), z (the element at 2 in clip) and w (the element at 3 in clip)
    set color to the UI scene shader color
    set vertex to the UI scene shader vertex color
    set mode to the shader uniform named "scene_mode" at binding 1 as (@intrinsic("type", "int", 32))
    set red to (the element at 0 in color) * (the x of vertex)
    set green to (the element at 1 in color) * (the y of vertex)
    set blue to (the element at 2 in color) * (the z of vertex)
    if mode = 1:
        set normal to the UI scene shader world normal
        set red to (the x of normal) * 0.5 + 0.5
        set green to (the y of normal) * 0.5 + 0.5
        set blue to (the z of normal) * 0.5 + 0.5
    else if mode = 2:
        set flags to the UI scene shader flags
        set red to 1.0 if (the element at 0 in flags) = (4294967295 as a 32 bit unsigned integer), else 0.0
        set green to (the element at 1 in flags) as a 32 bit floating-point number
        set blue to ((the element at 2 in flags) as a 32 bit floating-point number) * 0.25 + ((the element at 3 in flags) as a 32 bit floating-point number) * 0.5
    else if mode = 3:
        set surface to the UI scene shader surface
        set red to the element at 0 in surface
        set green to the element at 1 in surface
        set blue to (the element at 2 in surface) * 0.5 + 0.5
    else if mode = 4:
        set emission to the UI scene shader emission
        set red to the element at 0 in emission
        set green to the element at 1 in emission
        set blue to the element at 2 in emission
    else if mode = 5:
        set coordinates to the UI scene shader coordinates
        set red to the element at 0 in coordinates
        set green to the element at 1 in coordinates
        set blue to the element at 3 in color
    else if mode = 6:
        set coordinates to the UI scene shader coordinates
        set left to a new vector with x ((the element at 0 in coordinates) * 4.0), y ((the element at 1 in coordinates) * (8.0 / 3.0)) and z ((the element at 0 in coordinates) * 12.0)
        set right to a new vector with x 3.0, y 2.0 and z 1.0
        set sum to (left + right) normalized
        set cross to the cross product of left and right
        set difference to (left * right) / right - left
        set red to sum's x + difference's x
        set green to (the dot product of left and right) / 20.0 + difference's y
        set blue to cross' y / 16.0 + difference's z
    else if mode = 7:
        set coordinates to the UI scene shader coordinates
        set left to a new vector with x 0.0, y 0.0 and z 0.0
        set copy to left
        set the x coordinate of left to the element at 0 in coordinates
        set the y coordinate of left to (the element at 1 in coordinates) - 0.25
        set the z coordinate of left to the element at 1 in coordinates
        set red to left's x + copy's x
        set green to left's y + copy's y
        set blue to left's z + copy's z
    else if mode = 8:
        set coordinates to the UI scene shader coordinates
        set zero to (a new vector with x ((the element at 0 in coordinates) - 0.25), y ((the element at 1 in coordinates) - 0.75) and z 0.0) normalized
        set red to zero's x + 0.25
        set green to zero's y + 0.5
        set blue to zero's z + 0.75
    else if mode = 9:
        set normal to the UI scene shader world normal from (a new vector with x 0.2, y 0.7 and z -0.4)
        set red to (the x of normal) * 0.5 + 0.5
        set green to (the y of normal) * 0.5 + 0.5
        set blue to (the z of normal) * 0.5 + 0.5
    set the smooth shader interpolant named "scene_color" at location 0 to ([red, green, blue, 1.0] as an aggregate of 4 floating-point number values)
else:
    set color to the smooth shader interpolant named "scene_color" at location 0 of type an aggregate of 4 floating-point number values
    set the fragment color with a red channel of (the element at 0 in color), a green channel of (the element at 1 in color), a blue channel of (the element at 2 in color) and an alpha channel of 1.0
