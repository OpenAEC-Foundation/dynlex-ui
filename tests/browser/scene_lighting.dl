import ../../ui/scene_lighting.dl
import lib/shader.dl

to get [the lighting vector in] {a value:value}:
    return a new vector with x (the element at 0 in value), y (the element at 1 in value) and z (the element at 2 in value)

set surface to the shader uniform named "normal_roughness" at binding 0 as @intrinsic("vector", 4)
set observer to the shader uniform named "view_metalness" at binding 1 as @intrinsic("vector", 4)
set illumination to the shader uniform named "light_scale" at binding 2 as @intrinsic("vector", 4)
set reflectance to the shader uniform named "specular_mode" at binding 3 as @intrinsic("vector", 4)
set rawAlbedo to the shader uniform named "albedo" at binding 4 as @intrinsic("vector", 4)
set rawSky to the shader uniform named "sky" at binding 5 as @intrinsic("vector", 4)
set rawGround to the shader uniform named "ground" at binding 6 as @intrinsic("vector", 4)
set rawRadiance to the shader uniform named "radiance" at binding 7 as @intrinsic("vector", 4)
set rawIrradiance to the shader uniform named "irradiance" at binding 8 as @intrinsic("vector", 4)
set rawFirst to the shader uniform named "dfg_view" at binding 9 as @intrinsic("vector", 4)
set rawSecond to the shader uniform named "dfg_light" at binding 10 as @intrinsic("vector", 4)
set normal to the lighting vector in surface
set view to the lighting vector in observer
set light to the lighting vector in illumination
set base to the lighting vector in reflectance
set roughness to the element at 3 in surface
set metalness to the element at 3 in observer
set scale to the element at 3 in illumination
set mode to (the element at 3 in reflectance) as an integer
set first to the lighting vector in rawFirst
set second to the lighting vector in rawSecond
set albedo to the lighting vector in rawAlbedo
set sky to the lighting vector in rawSky
set ground to the lighting vector in rawGround
set radiance to the lighting vector in rawRadiance
set irradiance to the lighting vector in rawIrradiance
set single to the UI scene GGX reflection on normal viewed along view lit along light with Fresnel base roughness roughness
set multiple to the UI scene direct scattering compensation from base integrated for view first light second
set diffuse to the UI scene diffuse reflectance of albedo at metalness metalness
set color to single
if mode = 1:
    set half to (light + view) normalized
    set cosine to (the dot product of view and half) clamped between 0.0 and 1.0
    set color to the UI scene Fresnel from base at cosine cosine
if mode = 2:
    set color to first
if mode = 3:
    set color to second
if mode = 4:
    set color to single + multiple
if mode = 5:
    set color to the UI scene hemisphere light on normal from sky sky ground ground along (a new vector with x 0.0, y 1.0 and z 0.0)
if mode = 6:
    set color to the UI scene environment specular on albedo at metalness metalness integrated as first reflecting radiance lit by irradiance
if mode = 7:
    set color to the UI scene environment diffuse on albedo at metalness metalness integrated as first lit by irradiance
if mode = 8:
    set cosine to (the dot product of normal and light) clamped between 0.0 and 1.0
    set color to ((diffuse + (single + multiple)) * radiance) * cosine
if mode = 9:
    set color to diffuse * irradiance
set color to color * scale
set the fragment color with a red channel of (the x of color), a green channel of (the y of color), a blue channel of (the z of color) and an alpha channel of 1.0
