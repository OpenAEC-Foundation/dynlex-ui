import lib/shader.dl

if this is a vertex shader:
    set position to the vertex input named "position" at location 0 of type an aggregate of 4 floating-point number values
    set amount to the vertex input named "amount" at location 1 of type a floating-point number
    set flags to the vertex input named "flags" at location 2 of type an unsigned 32 bit integer
    set {signed pair} to the vertex input named "signed pair" at location 3 of type an aggregate of 2 signed 32 bit integer values
    set the smooth shader interpolant named "unused" at location 0 to amount
    set the smooth shader interpolant named "amount" at location 7 to amount
    set the flat shader interpolant named "flags" at location 3 to flags
    set the flat shader interpolant named "signed pair" at location 9 to signed pair
    set the flat shader interpolant named "flat amount" at location 12 to amount
    @intrinsic("shader output", position)
else:
    set pair to the flat shader interpolant named "signed pair" at location 9 of type an aggregate of 2 signed 32 bit integer values
    set flags to the flat shader interpolant named "flags" at location 3 of type an unsigned 32 bit integer
    set {smooth amount} to the smooth shader interpolant named "amount" at location 7 of type a floating-point number
    set {flat amount} to the flat shader interpolant named "flat amount" at location 12 of type a floating-point number
    set red to 0.0
    if flags = (4294967295 as an unsigned 32 bit integer) and (the element at 0 in pair) = -9 and (the element at 1 in pair) = 12:
        set red to 0.5
    set green to 0.125
    if the fragment is front facing:
        set green to 0.75
    set mode to the shader uniform named "mode" at binding 0 as an integer
    set blue to smooth amount
    if mode = 1:
        set blue to flat amount
    set the fragment color with a red channel of red, a green channel of green, a blue channel of blue and an alpha channel of 1.0
