import ../../ui/scene_sampling.dl
import lib/shader.dl

set parameters to the shader uniform named "cube" at binding 0 as @intrinsic("vector", 4)
set u to (the fragment x coordinate) / (the element at 0 in parameters)
set v to (the fragment y coordinate) / (the element at 1 in parameters)
set face to (the element at 2 in parameters) as an integer
set direction to the UI scene cube direction on face face at u v
set color to direction * 0.5 + 0.5
set the fragment color with a red channel of (the x of color), a green channel of (the y of color), a blue channel of (the z of color) and an alpha channel of 1.0
