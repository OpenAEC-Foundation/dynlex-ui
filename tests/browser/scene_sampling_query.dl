import lib/shader.dl

set query to the shader uniform named "query" at binding 0 as @intrinsic("vector", 4)
set cube to the shader cube image named "cube" at binding 1
set lookup to the shader image named "dfg" at binding 2
set pixel to the shader sampler named "pixel" at binding 3
set mode to the element at 3 in query
if mode = 0.0:
    set direction to @intrinsic("construct", @intrinsic("vector", 3), (the element at 0 in query), (the element at 1 in query), (the element at 2 in query))
    @intrinsic("shader output", the sample from cube using pixel at direction with level 0.0)
else:
    set uv to @intrinsic("construct", @intrinsic("vector", 2), (the element at 0 in query), (the element at 1 in query))
    @intrinsic("shader output", the sample from lookup using pixel at uv with level 0.0)
