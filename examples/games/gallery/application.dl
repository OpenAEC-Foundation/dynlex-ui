import painting.dl
import ../input.dl

to read gallery input from {a pointer to UI view:view}:
    close a game from view
    set session to the gallery in (view's instance)
    if view's input kind = 9:
        if view's key press is one of [the UI space key, the UI R key, the UI left arrow key, the UI right arrow key]:
            set view's key press to -1
        return nothing
    if view's input kind = 3:
        set key to view's key press
        if key = the UI space key:
            set session's paused to not session's paused
            if session's paused:
                show page "paused" in (view's instance)
            else:
                show page "playing" in (view's instance)
        if key = the UI R key:
            set session's elapsed, session's camera x and session's camera y to 0.0
            set session's pulse to -10.0
        if key = the UI left arrow key:
            set session's selected to (session's selected + 4) mod 5
        if key = the UI right arrow key:
            set session's selected to (session's selected + 1) mod 5
        if view's key press is one of [the UI space key, the UI R key, the UI left arrow key, the UI right arrow key]:
            set view's damaged to true
            set view's key press to -1
    if (view's input kind = 2) and view's down:
        set cursor to the UI cursor in view
        set box to session's bounds
        set inside to (cursor's x from (box's x) until (box's x + box's width)) and (cursor's y from (box's y) until (box's y + box's height))
        if inside and ((session's selected = 4) and not session's paused):
            set session's pulse to session's elapsed

to advance the gallery frame in {a pointer to UI view:view}:
    set session to the gallery in (view's instance)
    if not session's paused:
        add view's frame seconds to session's elapsed
        if session's selected = 4:
            set movement to view's frame seconds * 0.72
            if key (the UI A key) is held in view:
                subtract movement from session's camera x
            if key (the UI D key) is held in view:
                add movement to session's camera x
            if key (the UI W key) is held in view:
                add movement to session's camera y
            if key (the UI S key) is held in view:
                subtract movement from session's camera y
            clamp session's camera x between -0.82 and 0.82
            clamp session's camera y between -0.52 and 0.52
        animate UI view view
    set names to ["MANDELBROT", "PLASMA", "JULIA", "RINGS", "EVENT HORIZON"]
    set the text of "Current study" in (view's instance) to the item at (session's selected) in names

to explore shaders in {UI reference:description} starting with {integer:selection}:
    set session to a new gallery session
    set session's selected to selection
    set session's pulse to -10.0
    set interface to an instance of description with state (the address of session)
    bind (the control labeled "Study" in (the address of interface)) in (the address of interface) to (the function named "paint the gallery on $") for event 1
    set view to a desktop view of (the address of interface) sized 1280 by 780 using fonts "assets/fonts/NotoSans-Regular.ttf" and "assets/fonts/NotoSans-SemiBold.ttf"
    set surface to the native UI surface in (the address of view)
    set paths to ["build/games/shaders/mandelbrot.spv", "build/games/shaders/plasma.spv", "build/games/shaders/julia.spv", "build/games/shaders/rings.spv", "build/games/shaders/horizon.spv"]
    for each path at index in paths:
        store (a shader program for (surface's resource) using vertex shader at "build/games/shaders/vertex.spv" and fragment shader at path) into session's programs at index
    watch UI input in (the address of view) using (the function named "read gallery input from $")
    update UI frames in (the address of view) using (the function named "advance the gallery frame in $")
    run the address of view
    loop index from 0 to the length of session's programs:
        release the item at index in (session's programs)
    close the address of view
    close the address of interface
