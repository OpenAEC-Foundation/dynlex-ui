# Browser primitives implement the shared shader operation table.
import ../../ui/shaders.dl

to get [render browser shader in] {a pointer to UI view:view} [holding] {a pointer:shader} [sized] {integer:width} [by] {integer:height}:
    return @intrinsic("call", "dynlex_ui", "ui_shader_frame", a pointer, view's window, shader, width, height)

to [set browser shader uniform in] {a pointer to UI view:view} [holding] {a pointer:shader} [pass] {integer:pass} [group] {integer:group} [binding] {integer:binding} [scalar] {integer:scalar} [rows] {integer:rows} [columns] {integer:columns} [from] {a pointer:data} [counting] {integer:count}:
    @intrinsic("call", "dynlex_ui", "ui_shader_uniform", nothing, view's window, shader, pass, group, binding, scalar, rows, columns, data, count)

to [upload browser shader in] {a pointer to UI view:view} [holding] {a pointer:shader} [pass] {integer:pass} [slot] {integer:slot} [from] {a pointer:data} [counting] {integer:count}:
    @intrinsic("call", "dynlex_ui", "ui_shader_vertex_buffer", nothing, view's window, shader, pass, slot, data, count)

to [index browser shader in] {a pointer to UI view:view} [holding] {a pointer:shader} [pass] {integer:pass} [from] {a pointer to a 32 bit unsigned integer:data} [counting] {integer:count}:
    @intrinsic("call", "dynlex_ui", "ui_shader_index_buffer", nothing, view's window, shader, pass, data, count)

to [draw browser shader in] {a pointer to UI view:view} [holding] {a pointer:shader} [pass] {integer:pass} [from] {a pointer to UI shader draw:data} [counting] {integer:count}:
    @intrinsic("call", "dynlex_ui", "ui_shader_draws", nothing, view's window, shader, pass, data, count)

to [set browser shader pass in] {a pointer to UI view:view} [holding] {a pointer:shader} [pass] {integer:pass} [enabled] {integer:enabled}:
    @intrinsic("call", "dynlex_ui", "ui_shader_pass_enabled", nothing, view's window, shader, pass, enabled)

to get [browser shader bytes in] {a pointer to UI view:view} [holding] {a pointer:shader} [pass] {integer:pass} [slot] {integer:slot}:
    return @intrinsic("call", "dynlex_ui", "ui_shader_buffer_bytes", an integer, view's window, shader, pass, slot)

to get [browser shader records in] {a pointer to UI view:view} [holding] {a pointer:shader} [pass] {integer:pass} [slot] {integer:slot}:
    return @intrinsic("call", "dynlex_ui", "ui_shader_buffer_records", an integer, view's window, shader, pass, slot)

to get [browser shader indices in] {a pointer to UI view:view} [holding] {a pointer:shader} [pass] {integer:pass}:
    return @intrinsic("call", "dynlex_ui", "ui_shader_index_count", an integer, view's window, shader, pass)

to [close browser shader in] {a pointer to UI view:view} [holding] {a pointer:shader}:
    @intrinsic("call", "dynlex_ui", "ui_shader_close", nothing, view's window, shader)

to [upload browser shader image in] {a pointer to UI view:view} [holding] {a pointer:shader} [named] {a pointer:name} [counting] {integer:length} [at level] {integer:level} [layer] {integer:layer} [from] {a pointer:data} [spanning] {integer:count}:
    @intrinsic("call", "dynlex_ui", "ui_shader_image", nothing, view's window, shader, name, length, level, layer, data, count)

the browser UI shader operations means: a static reference to @intrinsic("construct", UI shader operations,
    (the function named "render browser shader in $ holding $ sized $ by $") as a pointer,
    (the function named "set browser shader uniform in $ holding $ pass $ group $ binding $ scalar $ rows $ columns $ from $ counting $") as a pointer,
    (the function named "upload browser shader in $ holding $ pass $ slot $ from $ counting $") as a pointer,
    (the function named "index browser shader in $ holding $ pass $ from $ counting $") as a pointer,
    (the function named "draw browser shader in $ holding $ pass $ from $ counting $") as a pointer,
    (the function named "browser shader bytes in $ holding $ pass $ slot $") as a pointer,
    (the function named "browser shader records in $ holding $ pass $ slot $") as a pointer,
    (the function named "browser shader indices in $ holding $ pass $") as a pointer,
    (the function named "upload browser shader image in $ holding $ named $ counting $ at level $ layer $ from $ spanning $") as a pointer,
    (the function named "close browser shader in $ holding $") as a pointer,
    (the function named "set browser shader pass in $ holding $ pass $ enabled $") as a pointer)
