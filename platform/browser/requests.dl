# Browser implementation of the shared host capability contract.
import services.dl
import ../../ui/services.dl

# The host transfers an allocation; the returned string owns its copied bytes.
local function [call browser UI capability] {a pointer:context} [in] {a pointer to UI view:view} [named] {C string:name} [containing] {string:payload}:
    execute:
        ignore context
        set data to 0 as a pointer to byte
        set count to 0
        set status to @intrinsic("call", "dynlex_ui", "ui_call", an integer, view's window, name, the data of payload, payload's length, the address of data, the address of count)
        set contents to the string form of ""
        if status = 0:
            set contents to the substring of (a new string from data containing count bytes) from 0 spanning count bytes
            deallocate data
        return @intrinsic("construct", UI call result, status = 0, contents)

local function [request browser UI capability] {a pointer:context} [in] {a pointer to UI view:view} [named] {C string:name} [containing] {string:payload}:
    execute:
        ignore context
        return @intrinsic("call", "dynlex_ui", "ui_request", an integer, view's window, name, the data of payload, payload's length)

local function [cancel browser UI capability] {a pointer:context} [in] {a pointer to UI view:view} [numbered] {integer:request}:
    execute:
        ignore context
        ignore view
        return @intrinsic("call", "dynlex_ui", "ui_cancel_request", a boolean, request)

the browser UI service provider means: a static reference to @intrinsic("construct", UI service provider,
    @intrinsic("construct", a pointer),
    the function named "call browser UI capability $ in $ named $ containing $",
    the function named "request browser UI capability $ in $ named $ containing $",
    the function named "cancel browser UI capability $ in $ numbered $")
