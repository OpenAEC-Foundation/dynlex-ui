import lib/std.dl

to get [the UI scene angle of] {floating-point number:value}:
    set angle to value % 6.283185307179586
    if angle > 3.141592653589793:
        set angle to angle - 6.283185307179586
    if angle < -3.141592653589793:
        set angle to angle + 6.283185307179586
    return angle
