# Navigation reads retained source geometry, including edits queued before paint.
import text_layout.dl
import view_lookup.dl

to refresh UI text geometry for {a pointer to UI text source:source} in {a pointer to UI view:view}:
    set layout to the UI layout for element (source's element) in view
    require condition (layout != @intrinsic("construct", a pointer to UI layout)) reporting "Editable text has no retained layout"
    set content to the presented UI text of source in view
    set changed to false
    if (layout's node's kind = 39) and (view's instance's description's kind != 40):
        set changed to ((@intrinsic("equal", layout's typeface's resource, view's typeface's resource)) = false) or (layout's typeface's size != view's typeface's size)
        set layout's typeface to view's typeface
        set layout's appearance to default UI appearance settings
        set layout's appearance's foreground to view's theme's text
        set layout's appearance's background to view's theme's surface
    if ((layout's content = content) and (layout's lines != @intrinsic("construct", a pointer to UI text line))) and (changed = false):
        return nothing
    set layout's content to content
    set span to 1.0e30
    if (layout's node's kind != 39) and (layout's appearance's unwrapped = false):
        set span to the maximum of 1.0 and (layout's bounds' width - layout's appearance's padding * 2.0)
    ignore the number of wrapped UI rows in layout within span
    set layout's text width to 0.0
    set line to layout's lines
    loop while line != @intrinsic("construct", a pointer to UI text line):
        set layout's text width to the maximum of (layout's text width) and (line's width)
        set line to line's next

