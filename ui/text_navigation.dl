import text.dl
import text_geometry.dl

to get the UI caret row for {a pointer to UI text source:source} at {integer:position} in {a pointer to UI view:view}:
    set layout to the UI layout for element (source's element) in (view's layout)
    set line to layout's lines
    loop while line != @intrinsic("construct", a pointer to UI text line):
        set ending to true
        if line's next != @intrinsic("construct", a pointer to UI text line):
            set ending to line's end < line's next's start
        if (position >= line's start) and ((position < line's end) or ((position = line's end) and ending)):
            return line
        set line to line's next
    abort the program
    return @intrinsic("construct", a pointer to UI text line)

to get the UI vertical destination from {integer:position} in {a pointer to UI text source:source} toward {integer:direction} in {a pointer to UI view:view}:
    set current to the UI caret row for source at position in view
    set layout to the UI layout for element (source's element) in (view's layout)
    if view's selection's vertical = false:
        set view's selection's preferred x to the width of (the substring of (source's text) from (current's start) spanning (position - current's start) bytes) using (layout's typeface)
    set view's selection's vertical to true
    set line to layout's lines
    set candidate to current
    set distance to 1.0e30
    loop while line != @intrinsic("construct", a pointer to UI text line):
        set delta to (line's top - current's top) * direction
        if (delta > 0.0) and (delta < distance):
            set distance to delta
            set candidate to line
        set line to line's next
    set content to the substring of (source's text) from (candidate's start) spanning (candidate's end - candidate's start) bytes
    return candidate's start + (the UI byte at (view's selection's preferred x) in content using (layout's typeface))
