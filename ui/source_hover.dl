# Inspection follows retained source geometry, independent of application and
# keyboard focus. The ordinary text popover owns wrapping, selection and copy.
import source_buffers.dl
import source_hover_types.dl
import source_hover_content.dl

to get [the UI source editor under] {a pointer to UI text run:run} [in] {a pointer to UI source workspace:workspace}:
    set editor to workspace's editors
    loop while editor != @intrinsic("construct", a pointer to UI source editor):
        if editor's node = run's source's element:
            return editor
        set editor to editor's next
    return editor

to get [UI source hover] {a pointer to UI source hover:hover} [is current]:
    if hover's phase = 0:
        return false
    if (hover's editor's document != hover's document) or (hover's document's available = false):
        return false
    if hover's query != @intrinsic("construct", a pointer to UI source query):
        return (hover's query's generation = hover's generation) and (hover's query is current for UI source document (hover's document))
    return true

# A short leave interval lets the pointer cross the gap into selectable text.
to get [retain UI source hover while leaving] {a pointer to UI source hover:hover} [in] {a pointer to UI view:view}:
    if hover's popover's visible = false:
        return false
    if hover's leave deadline = 0.0:
        set hover's leave deadline to view's seconds + 0.18
    if view's seconds < hover's leave deadline:
        animate UI view view
        return true
    dismiss UI source hover hover in view
    return false

to [update UI source hover in] {a pointer to UI source tools:tools}:
    set view to tools's view
    set workspace to tools's workspace as a pointer to UI source workspace
    set hover to the address of (tools's hover)
    set selecting to view's selection's limit = (the address of (hover's popover's layout's text source))
    if (((view's active = false) or (workspace's client's phase = 8)) or (tools's mode != 0)) or ((view's selection's composing) or ((view's selection's dragging) and (selecting = false))):
        dismiss UI source hover hover in view
        return nothing
    set cursor to the UI cursor in view
    set current to UI source hover hover is current
    if (current = false) and (hover's phase != 0):
        dismiss UI source hover hover in view
    if current and (hover's popover's visible):
        if (cursor is inside (hover's popover's bounds)) or (view's selection's limit = (the address of (hover's popover's layout's text source))):
            set hover's leave deadline to 0.0
            return nothing
    set run to the UI text hit at cursor in view
    if run = @intrinsic("construct", a pointer to UI text run):
        if (retain UI source hover while leaving hover in view) = false:
            dismiss UI source hover hover in view
        return nothing
    set editor to the UI source editor under run in workspace
    if editor = @intrinsic("construct", a pointer to UI source editor):
        if (retain UI source hover while leaving hover in view) = false:
            dismiss UI source hover hover in view
        return nothing
    set layout to the UI layout for element (editor's node) in (view's layout)
    if (((editor's document's available = false) or (run's source's text != editor's document's source)) or (layout's content != editor's document's source)) or ((UI source element (editor's node) is active within (view's instance's description) in (view's instance)) = false):
        dismiss UI source hover hover in view
        return nothing
    set local to UI text position of cursor in run
    if (local's x < run's origin's x) or (local's x > (run's origin's x + (the width of (run's text) using (run's typeface)))):
        if (retain UI source hover while leaving hover in view) = false:
            dismiss UI source hover hover in view
        return nothing
    set position to run's start + (the UI text byte at (local's x - run's origin's x) in run)
    if ((current = false) or (hover's editor != editor)) or (hover's position != position):
        if retain UI source hover while leaving hover in view:
            return nothing
        dismiss UI source hover hover in view
        set hover's editor to editor
        set hover's document to editor's document
        set hover's position to position
        set hover's anchor to UI box at (cursor's x) (cursor's y) sized 1 18
        set hover's deadline to view's seconds + 0.35
        set hover's phase to 1
    set hover's leave deadline to 0.0
    if hover's phase = 1:
        if view's seconds < hover's deadline:
            animate UI view view
            return nothing
        set hover's query to request UI source feature "textDocument/hover" at byte (hover's position) in (hover's document)
        set hover's generation to hover's query's generation
        set hover's phase to 2
    if (hover's phase = 2) and (hover's query's ready):
        set text to the UI source hover text of (hover's query's result)
        set hover's phase to 4
        if text's length > 0:
            set UI text popover (the address of (hover's popover)) to text in view
            set hover's phase to 3

function [paint UI source hover in] {a pointer to UI source tools:tools} [on] {UI frame:frame}:
    globals:
        UI text popover appearance
    execute:
        set hover to the address of (tools's hover)
        if (tools's mode != 0) or (hover's popover's visible = false):
            return nothing
        set view to frame's view
        set layout to the UI layout for element (hover's editor's node) in (view's layout)
        if ((UI source hover hover is current) = false) or (layout's paint generation != view's paint count):
            dismiss UI source hover hover in view
            return nothing
        set style to UI appearance UI text popover appearance resolved for (view's width as a floating-point number)
        set style's background to layout's appearance's background
        set style's foreground to layout's appearance's foreground
        set style's border ink to UI ink between (style's background) and (style's foreground) at 0.2
        set tools's overlay's layout to the address of (hover's popover's layout)
        paint UI text popover (the address of (hover's popover)) anchored at (hover's anchor) within (the UI viewport bounds in view) using (layout's typeface) styled style on frame

to get [read UI source hover in] {a pointer to UI source tools:tools}:
    set hover to the address of (tools's hover)
    set visible to hover's popover's visible
    set selected to tools's view's selection's limit = (the address of (hover's popover's layout's text source))
    set consumed to read UI text popover (the address of (hover's popover)) in (tools's view)
    if visible and (hover's popover's visible = false):
        set hover's phase to 4
        if selected and consumed:
            set view to tools's view
            set workspace to tools's workspace as a pointer to UI source workspace
            set editor to workspace's editors
            loop while editor != @intrinsic("construct", a pointer to UI source editor):
                if editor's node = view's text focus:
                    if ((editor's document's available) and (the UI element (editor's node) is enabled in (view's instance))) and (UI source element (editor's node) is active within (view's instance's description) in (view's instance)):
                        restore UI source location (editor's current) in editor in view
                set editor to editor's next
    if (consumed = false) and (tools's view's key press >= 0):
        dismiss UI source hover hover in (tools's view)
    return consumed
