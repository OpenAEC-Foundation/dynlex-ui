# A delivery is fresh (0), queued (1), delivered (2), or cancelled (3).
# The requesting caller retains it until the queue has retired the event.
class:
    patterns:
        UI input delivery
    members:
        status as an integer
        handled as a boolean

class:
    patterns:
        UI input event
    members:
        kind as an integer
        key as an integer
        x as a floating-point number
        y as a floating-point number
        modifiers as an integer
        text as a string
        next as a pointer to UI input event
        delivery as a pointer to UI input delivery
