import source_queries.dl
import text_popovers.dl

class:
    patterns:
        UI source hover
    members:
        editor as a pointer to UI source editor
        document as a pointer to UI source document
        query as a pointer to UI source query
        generation as an integer
        phase as an integer
        position as an integer
        deadline as a floating-point number
        leave deadline as a floating-point number
        anchor as UI bounds
        popover as UI text popover

to [dismiss UI source hover] {a pointer to UI source hover:hover} [in] {a pointer to UI view:view}:
    if hover's query != @intrinsic("construct", a pointer to UI source query):
        cancel UI source query (hover's query)
    set hover's query to @intrinsic("construct", a pointer to UI source query)
    dismiss UI text popover (the address of (hover's popover)) in view
    set hover's phase to 0
    set hover's leave deadline to 0.0
    set hover's editor to @intrinsic("construct", a pointer to UI source editor)
    set hover's document to @intrinsic("construct", a pointer to UI source document)
