# One source-control interaction layer for standalone and embedded workspaces.
import application.dl
import source_workspace.dl
import source_completion_tools.dl
import source_triggers.dl
import source_tools_rendering.dl
import source_navigation.dl
import source_pane_actions.dl
import source_hover.dl
import source_tool_focus.dl
import source_inspection.dl
import source_actions.dl

to get [read UI source tools] {a pointer:context} [in] {a pointer to UI view:view}:
    set tools to context as a pointer to UI source tools
    if read UI source hover in tools:
        return true
    set previous to tools's source
    set owner to tools's node
    if (focus UI source tools tools) = false:
        return false
    if (view's key press = 263) and (view's modifiers = 4):
        set editor to the UI source editor in tools
        begin UI source interaction in tools
        return go back in UI source editor editor in view
    if (view's selection's composing) or (view's input kind = 10):
        dismiss UI source tools tools
        set tools's edited to false
        if view's input kind = 10:
            if view's modifiers = 1:
                set tools's composed to false
            if view's modifiers = 2:
                set tools's composed to view's message's length > 0
        return false
    if (view's key press = 301) and (view's modifiers = 0):
        request a UI source definition in tools
        return true
    if (view's key press = 298) and (view's modifiers = 0):
        request a UI source outline in tools
        return true
    if (view's key press = 297) and (view's modifiers = 0):
        request UI source instances in tools
        return true
    if (view's key press = 296) and (view's modifiers = 0):
        request UI source fixes in tools
        return true
    set editable to (tools's document's writable) and (the UI element (tools's node) accepts edits in (view's instance))
    if editable = false:
        if tools's mode = 1:
            dismiss UI source tools tools
        set tools's edited to false
    set opened to tools's mode = 1
    if (tools's mode != 0) and (tools's mode != 2):
        if ((tools's query is current for UI source document (tools's document)) = false) or ((tools's mode != 3) and (tools's position != view's selection's caret)):
            dismiss UI source tools tools
    set command to ((view's modifiers bitwise and 10) != 0) and ((view's modifiers bitwise and 4) = 0)
    if command and (view's key press = 32):
        if editable:
            request UI source completions in tools
            return true
        return false
    if (view's input kind = 4) or (view's input kind = 13):
        set inserted to the string form of ""
        if view's input kind = 4:
            if view's input code = 0:
                set inserted to view's message
        else if owner = tools's node:
            set value to the UI value for (tools's node) in (view's instance)
            if value's undo != @intrinsic("construct", a pointer to UI text edit):
                if (value's undo's before = previous) and (value's undo's after = value's text):
                    set inserted to the UI source insertion from previous to (value's text)
        dismiss UI source tools tools
        set tools's edited to editable and ((UI source text inserted can trigger completion) or (tools's composed and (UI source text inserted completes a composition)))
        set tools's composed to false
        set tools's deadline to view's seconds + 0.12
        return false
    if (view's key press = 259) or (view's key press = 261):
        dismiss UI source tools tools
        set tools's edited to editable and opened
        set tools's deadline to view's seconds + 0.12
        return false
    if tools's mode = 0:
        return false
    set decision to read UI choice popover (the address of (tools's choices)) in view
    if decision = 3:
        dismiss UI source tools tools
        set tools's edited to false
        return view's key press = 256
    if decision = 2:
        if tools's mode = 1:
            accept the UI source completion in tools
        else if tools's mode = 5:
            accept UI source fix in tools
        else:
            accept UI source inspection in tools
        return true
    return decision = 1

to [close UI source tools] {a pointer:context} [in] {a pointer to UI view:view}:
    set tools to context as a pointer to UI source tools
    dismiss UI source hover (the address of (tools's hover)) in view
    clear UI text popover (the address of (tools's hover's popover)) in view
    set tools's view to @intrinsic("construct", a pointer to UI view)
    set tools's overlay to @intrinsic("construct", a pointer to UI overlay)

to [enable UI source tools for] {a pointer to UI source workspace:workspace} [in] {a pointer to UI view:view}:
    require condition (workspace's tools = @intrinsic("construct", a pointer to UI source tools)) reporting "Source tools are already enabled for this workspace"
    set tools to storage for one slot initialized with (a new UI source tools)
    set workspace's tools to tools
    set tools's workspace to workspace as a pointer
    set tools's view to view
    set tools's hover's popover to a UI text popover containing ""
    set tools's choices to a UI choice popover
    set tools's items to a new JSON-RPC array
    set tools's overlay to a UI overlay in view with context (tools as a pointer) handling input ((the function named "read UI source tools $ in $") as a pointer) painting ((the function named "paint UI source tools $ on $") as a pointer) closing ((the function named "close UI source tools $ in $") as a pointer)
    bind UI source panes in workspace

to [update UI source tools in] {a pointer to UI source workspace:workspace}:
    set tools to workspace's tools
    if tools = @intrinsic("construct", a pointer to UI source tools):
        return nothing
    set view to tools's view
    synchronize UI source workspace workspace at (view's seconds) seconds
    update UI source instance selection in tools
    update UI source navigation in tools
    update UI source hover in tools
    set editor to workspace's editors
    loop while editor != @intrinsic("construct", a pointer to UI source editor):
        if editor's pane != @intrinsic("construct", UI reference):
            refresh UI source search in editor in view
        set editor to editor's next
    if (focus UI source tools tools) = false:
        return nothing
    if (tools's mode != 0) and (tools's mode != 2):
        if ((tools's query is current for UI source document (tools's document)) = false) or ((tools's mode != 3) and (tools's position != view's selection's caret)):
            dismiss UI source tools tools
    if tools's edited and (view's selection's composing = false):
        if view's seconds >= tools's deadline:
            request UI source completions in tools
        else:
            animate UI view view
    if ((tools's mode = 1) or ((tools's mode = 3) or ((tools's mode = 4) or (tools's mode = 5)))) and (tools's query's ready):
        if tools's generation != tools's query's generation:
            if tools's mode = 1:
                free tools's items
                set tools's items to UI source completion items from (tools's query's result)
                clear UI choice popover (the address of (tools's choices)) in view
                set tools's choices' accepts tab to true
                set index to 0
                loop while index < tools's items's length:
                    add UI choice (the JSON text named "label" in (the JSON value at index index in (tools's items))) enabled true to (the address of (tools's choices))
                    increment index
                show UI choice popover (the address of (tools's choices)) reporting "" with hint "↑ ↓ choose  ·  Enter insert  ·  Esc close" in view
            else if tools's mode = 5:
                collect UI source fix choices in tools
            else:
                collect UI source inspection choices in tools
            set tools's generation to tools's query's generation
            set view's damaged to true
            if (tools's mode = 1) and (tools's items's length = 0):
                dismiss UI source tools tools
