# Language results use UTF-16 coordinates in the wrapped source. Controls use UTF-8
# bytes in the visible source. All editor features share this mapping.
import source_documents.dl
import text_colors.dl
import lib/unicode.dl

class:
    patterns:
        UI source span
    members:
        start as an integer
        end as an integer
        visible as a boolean

class:
    patterns:
        UI source token style
    members:
        name as a C string
        ink as UI paint

the default UI source token theme means: [
    @intrinsic("construct", UI source token style, "comment", UI ink 149 161 152),
    @intrinsic("construct", UI source token style, "string", UI ink 230 196 124),
    @intrinsic("construct", UI source token style, "number", UI ink 230 196 124),
    @intrinsic("construct", UI source token style, "keyword", UI ink 204 167 236),
    @intrinsic("construct", UI source token style, "section", UI ink 204 167 236),
    @intrinsic("construct", UI source token style, "type", UI ink 104 211 190),
    @intrinsic("construct", UI source token style, "patternDefinition", UI ink 104 211 190),
    @intrinsic("construct", UI source token style, "function", UI ink 104 211 190),
    @intrinsic("construct", UI source token style, "variable", UI ink 159 199 245),
    @intrinsic("construct", UI source token style, "parameter", UI ink 159 199 245),
    @intrinsic("construct", UI source token style, "property", UI ink 159 199 245)
]

to get [the UI source token ink for] {string:name} [using] {an array:theme}:
    set index to 0
    loop while index < the length of theme:
        set entry to the item at index in theme
        if name = entry's name:
            return entry's ink
        increment index
    return UI ink 245 245 244

to get [the UI analysis byte at line] {integer:row} [character] {integer:column} [in] {string:source} [indexed by] {a pointer to text line index:lines}:
    set start to the start of line row in lines
    set end to the content end of line row in lines
    require condition ((start succeeded) and (end succeeded)) reporting "A language result is outside its source"
    set text to the substring of source from (start's position) spanning (end's position - start's position) bytes
    set offset to the UTF-8 byte offset of UTF-16 position column in text
    require condition (offset succeeded) reporting "A language result splits a Unicode character"
    return start's position + offset's position

to get [the UI analysis position for source byte] {integer:offset} [in] {a pointer to UI source document:document}:
    require condition (0 <= offset <= document's source's length) reporting "An editor request is outside its visible source"
    set source to document's prefix + document's source
    set absolute to document's prefix's length + offset
    scan lines in source and set scanned to it
    require condition (scanned succeeded) reporting "The editor source is not valid UTF-8"
    set lines to the line index of scanned
    set row to the line number at byte offset absolute in lines
    require condition (row succeeded) reporting "An editor request is outside its analysis document"
    set start to the start of line (row's position) in lines
    set content to the substring of source from (start's position) spanning (absolute - start's position) bytes
    set position to the UTF-16 position of UTF-8 byte offset (content's length) in content
    require condition (position succeeded) reporting "An editor request splits a Unicode character"
    free lines
    return an LSP position at line (row's position) and character (position's position)

to get [the UI source span from] {integer:start} [to] {integer:end} [in] {a pointer to UI source document:document}:
    require condition (end >= start) reporting "A language source range is reversed"
    set prefix to document's prefix's length
    set first to the maximum of 0 and (start - prefix)
    set last to the minimum of (document's source's length) and (end - prefix)
    set visible to ((start >= prefix) and (start <= (prefix + document's source's length))) or ((end > prefix) and (start < (prefix + document's source's length)))
    return @intrinsic("construct", UI source span, first, the maximum of first and last, visible)

to get [the UI analysis span of] {a pointer to JSON value:range} [in] {string:source} [indexed by] {a pointer to text line index:lines}:
    set first to the JSON member named "start" in range
    set last to the JSON member named "end" in range
    set start to the UI analysis byte at line ((the JSON number named "line" in first) as an integer) character ((the JSON number named "character" in first) as an integer) in source indexed by lines
    set end to the UI analysis byte at line ((the JSON number named "line" in last) as an integer) character ((the JSON number named "character" in last) as an integer) in source indexed by lines
    require condition (end >= start) reporting "A language source range is reversed"
    return @intrinsic("construct", UI source span, start, end, true)

to get [the UI source range of] {a pointer to JSON value:diagnostic} [in] {a pointer to UI source document:document} [using] {string:source} [indexed by] {a pointer to text line index:lines}:
    set span to the UI analysis span of (the JSON member named "range" in diagnostic) in source indexed by lines
    return the UI source span from (span's start) to (span's end) in document

to get [the UI source range of] {a pointer to JSON value:diagnostic} [in] {a pointer to UI source document:document}:
    set source to document's prefix + document's source
    scan lines in source and set scanned to it
    require condition (scanned succeeded) reporting "The editor source is not valid UTF-8"
    set lines to the line index of scanned
    set span to the UI source range of diagnostic in document using source indexed by lines
    free lines
    return span

to [apply UI source colors from] {a pointer to UI source document:document} [to] {UI reference:node} [in] {a pointer to UI instance:instance} [using] {an array:theme}:
    if document's token revision != document's revision:
        return nothing
    if (the UI value for node in instance)'s text != document's source:
        return nothing
    color UI text (document's source) in node in instance
    set source to document's prefix + document's source
    scan lines in source and set scanned to it
    require condition (scanned succeeded) reporting "The editor source is not valid UTF-8"
    set lines to the line index of scanned
    set data to the JSON member named "data" in (document's tokens)
    require condition ((data's length mod 5) = 0) reporting "A semantic token response is incomplete"
    set index, row and column to 0
    loop while index < data's length:
        set delta to ((the JSON value at index index in data)'s number) as an integer
        if delta > 0:
            set column to 0
        set row to row + delta
        set column to column + (((the JSON value at index (index + 1) in data)'s number) as an integer)
        set length to ((the JSON value at index (index + 2) in data)'s number) as an integer
        set kind to ((the JSON value at index (index + 3) in data)'s number) as an integer
        set first to the UI analysis byte at line row character column in source indexed by lines
        set last to the UI analysis byte at line row character (column + length) in source indexed by lines
        set span to the UI source span from first to last in document
        require condition (0 <= kind < document's token types' length) reporting "A semantic token class is outside its legend"
        if span's end > span's start:
            set name to (the JSON value at index kind in (document's token types))'s text
            add UI text color (the UI source token ink for name using theme) from (span's start) to (span's end) in node in instance
        set index to index + 5
    free lines

to get [the UI source diagnostic text of] {a pointer to UI source document:document}:
    if document's diagnostic revision != document's revision:
        return the string form of ""
    set text to the string form of ""
    set analysis to document's prefix + document's source
    scan lines in analysis and set indexed to it
    require condition (indexed succeeded) reporting "The analysis source is not valid UTF-8"
    set catalogue to the line index of indexed
    scan lines in (document's source) and set scanned to it
    require condition (scanned succeeded) reporting "The editor source is not valid UTF-8"
    set lines to the line index of scanned
    set index to 0
    loop while index < document's diagnostics' length:
        set diagnostic to the JSON value at index index in (document's diagnostics)
        set span to the UI source range of diagnostic in document using analysis indexed by catalogue
        set name to document's filename
        set message to the JSON text named "message" in diagnostic
        if span's visible:
            set row to the line number at byte offset (span's start) in lines
            require condition (row succeeded) reporting "A mapped diagnostic is outside the editor source"
            set start to the start of line (row's position) in lines
            set content to the substring of (document's source) from (start's position) spanning (span's start - start's position) bytes
            set position to the UTF-16 position of UTF-8 byte offset (content's length) in content
            require condition (position succeeded) reporting "A mapped diagnostic splits a Unicode character"
            set line to row's position + 1
            set column to position's position + 1
            set text to text + (formatted "{name}:{line}:{column}: {message}\n")
        else:
            set text to text + (formatted "{name} (project context): {message}\n")
        increment index
    free lines
    free catalogue
    return text
