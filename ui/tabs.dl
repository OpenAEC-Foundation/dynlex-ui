# The same tab descriptions serve ribbons and responsive documents.
import components.dl

section tab {C string:name}:
    result: UI reference
    body:
        children: many UI reference
    value:
        a UI container of kind 29 containing (the body's children) named name

section tab group {C string:name} using {UI appearance reference:appearance}:
    result: UI reference
    body:
        children: many UI reference
    value:
        (a UI container of kind 48 containing (the body's children) named name) wearing appearance

to get the selected tab of {UI reference:group} in {a pointer to UI instance:instance}:
    require condition (((group's kind = 28) or (group's kind = 48)) and (group's count > 0)) reporting "A tab group requires at least one tab"
    return the selected UI child of group in instance

to get the selected UI child of {UI reference:group} in {a pointer to UI instance:instance}:
    require condition (group's count > 0) reporting "A selection group requires at least one view"
    set index to (the UI value for group in instance)'s number
    if (group's kind = 49) and (index = -1):
        return 0 as UI reference
    require condition ((index >= 0) and (index < group's count)) reporting "The selected view is outside its description"
    return the UI child at index in group

to get the active UI editor within {UI reference:node} in {a pointer to UI instance:instance}:
    if the UI element node is a text control:
        return node
    if node's kind = 48:
        return the active UI editor within (the selected tab of node in instance) in instance
    if node's kind = 49:
        set selected to the selected UI child of node in instance
        if selected = (0 as UI reference):
            return selected
        return the active UI editor within selected in instance
    set index to 0
    loop while index < node's count:
        set found to the active UI editor within (the UI child at index in node) in instance
        if found != @intrinsic("construct", UI reference):
            return found
        increment index
    return @intrinsic("construct", UI reference)
