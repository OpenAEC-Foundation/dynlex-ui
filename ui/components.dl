# Reusable controls and presentation data. Rendering lives in ui/renderer.dl.
import declarations.dl
import text_content.dl
import option_models.dl
import ranges.dl

a UI component {integer:kind} labeled {C string:text} styled {C string:variant} at {integer:left} {integer:top} sized {integer:width} by {integer:height} containing {an array:children} means: UI node kind with text colored "" sized 0 by 0 bordered 0 containing children acting no UI action at left top measuring width by height styled variant
a UI text component {integer:kind} labeled {C string:text} styled {C string:variant} means: a UI component kind labeled text styled variant at 0 0 sized 0 by 0 containing no UI children

eyebrow {C string:text} means: a UI text component 13 labeled text styled ""
title {C string:text} means: a UI text component 14 labeled text styled ""
accent title {C string:text} means: a UI text component 14 labeled text styled "accent"
heading {C string:text} means: a UI text component 24 labeled text styled ""
brand {C string:text} means: a UI text component 24 labeled text styled "brand"
caption {C string:text} means: a UI text component 15 labeled text styled ""
badge {C string:text} means: a UI text component 27 labeled text styled ""
space of {integer:height} pixels means: a UI component 16 labeled "" styled "" at 0 0 sized 0 by height containing no UI children
primary button {C string:text} means: a UI text component 2 labeled text styled "primary"
quiet button {C string:text} means: a UI text component 2 labeled text styled "quiet"
switch {C string:text} means: a UI text component 17 labeled text styled ""
option {C string:text} means: a UI text component 19 labeled text styled ""
text field {C string:label} containing {C string:initial} means: (a UI text component 39 labeled label styled "") with initial text initial
read only text field {C string:label} containing {C string:initial} means: (text field label containing initial) with read only text
statistic {C string:text} means: a UI text component 21 labeled text styled ""

section panel at {integer:left} {integer:top} sized {integer:width} by {integer:height}:
    result: UI reference
    body:
        children: many UI reference
    value:
        a UI component 12 labeled "" styled "card" at left top sized width by height containing (the body's children)

section group at {integer:left} {integer:top} sized {integer:width} by {integer:height}:
    result: UI reference
    body:
        children: many UI reference
    value:
        a UI component 12 labeled "" styled "plain" at left top sized width by height containing (the body's children)

section page {C string:name}:
    result: UI reference
    body:
        children: many UI reference
    value:
        a UI container of kind 22 containing (the body's children) named name

a UI container of kind {integer:kind} containing {an array:children} named {C string:name} means: a UI component kind labeled name styled "" at 0 0 sized 0 by 0 containing children

section choices {C string:name}:
    result: UI reference
    body:
        children: many UI reference
    value:
        a UI component 18 labeled name styled "" at 0 0 sized 0 by 0 containing (the body's children)

canvas {C string:name} at {integer:left} {integer:top} sized {integer:width} by {integer:height} means: a UI component 20 labeled name styled "" at left top sized width by height containing no UI children
the interface uses [a|an] {C string:name} theme means: a UI text component 25 labeled name styled ""
the interface fits {integer:width} by {integer:height} pixels means: a UI component 26 labeled "" styled "" at 0 0 sized width by height containing no UI children

to get the UI element labeled {C string:label} in {UI reference:root}:
    if root's text = label:
        return root
    set index to 0
    loop while index < root's count:
        set found to the UI element labeled label in (the UI child at index in root)
        if found != @intrinsic("construct", UI reference):
            return found
        increment index
    return @intrinsic("construct", UI reference)

to get the control labeled {C string:label} in {a pointer to UI instance:instance}:
    set found to the UI element labeled label in (instance's description)
    require condition (found != @intrinsic("construct", UI reference)) reporting "The UI control does not exist"
    return found

to [set the choices of] {C string:label} [in] {a pointer to UI instance:instance} [to] {UI option values:options} [choosing] {a value:key}:
    set UI choices of (the control labeled label in instance) in instance to options choosing key

to get [the selected choice of] {C string:label} [in] {a pointer to UI instance:instance}:
    return the selected UI option identity of (the control labeled label in instance) in instance

to get the UI value for {UI reference:node} in {a pointer to UI instance:instance}:
    set entry to the existing UI value for node in instance
    if entry != (0 as a pointer to UI value):
        return entry
    set {new entry} to a new UI value
    set new entry's target to node
    set new entry's enabled to true
    set new entry's read only to node's read only
    set new entry's text to node's content
    if (node's kind = 39) or (node's kind = 50):
        set new entry's text to UI text accepted from (new entry's text) by node
    if (node's kind = 43) or (node's kind = 45):
        set new entry's destination to node's destination
    if node's kind = 34:
        set index to 0
        loop while index < node's count:
            require condition ((the UI child at index in node)'s kind = 35) reporting "Choice fields contain choices"
            increment index
        if node's count = 0:
            require condition (new entry's text is empty) reporting "An empty choice field cannot have an initial selection"
            set new entry's number to -1
        else:
            set index to the position of UI option (new entry's text) in node using (the address of new entry)
            select UI option index from node into (the address of new entry)
    if node's kind = the UI range kind:
        set new entry's amount to the initial UI range amount of node
    if node's kind = 21:
        set new entry's text to "0"
    set result to storage for one slot initialized with new entry
    insert result into (the address of (instance's values)) at index (the UI value position for node in instance)
    return result

to [set UI text of] {UI reference:node} [in] {a pointer to UI instance:instance} [to] {a value:text}:
    set entry to the UI value for node in instance
    set content to the string form of text
    if (node's kind = 39) or (node's kind = 50):
        set content to UI text accepted from content by node
    if entry's text = content:
        return nothing
    if node's kind = 34:
        select UI option (the position of UI option content in node using entry) from node into entry
    else:
        set entry's text to content
    invalidate instance

to set the text of {C string:label} in {a pointer to UI instance:instance} to {a value:text}:
    set UI text of (the control labeled label in instance) in instance to text

to set the value of {C string:label} in {a pointer to UI instance:instance} to {integer:number}:
    set node to the control labeled label in instance
    set entry to the UI value for node in instance
    if entry's number = number:
        return nothing
    if node's kind = 34:
        select UI option number from node into entry
    else:
        set entry's number to number
    invalidate instance

to set the destination of {C string:label} in {a pointer to UI instance:instance} to {string:destination}:
    set node to the control labeled label in instance
    require condition (node's kind = 43) reporting "Only a link has a navigation destination"
    set entry to the UI value for node in instance
    if entry's destination != destination:
        set entry's destination to destination
        invalidate instance

to get the value of {C string:label} in {a pointer to UI instance:instance}:
    return (the UI value for (the control labeled label in instance) in instance)'s number

to set the source of picture {C string:label} in {a pointer to UI instance:instance} to {string:path}:
    set node to the control labeled label in instance
    require condition (node's kind = 45) reporting "Only a picture has an image source"
    require condition (path's length > 0) reporting "A picture requires an image source"
    set entry to the UI value for node in instance
    if entry's destination != path:
        set entry's destination to path
        invalidate instance

to get the {C string:label} switch is on in {a pointer to UI instance:instance}:
    return (the value of label in instance) != 0

to show page {C string:name} in {a pointer to UI instance:instance}:
    set selected to the control labeled name in instance
    require condition (selected's kind = 22) reporting "The selected UI element is not a page"
    if selected != instance's page:
        set instance's page to selected
        invalidate instance

to bind {UI reference:target} in {a pointer to UI instance:instance} to {a callback:action} for event {integer:event}:
    bind UI action action to target in instance for event event with context @intrinsic("construct", a pointer)

to bind {UI reference:target} in {a pointer to UI instance:instance} to {a callback:action} for event {integer:event} with context {a pointer:context}:
    bind UI action action to target in instance for event event with context context

section when the {C string:label} control changes:
    receiver: a pointer to UI instance
    returns: nothing
    value:
        bind (the control labeled label in this window) in this window to @intrinsic("deferred body") for event 0

to get the UI element {UI reference:node} has input in {a pointer to UI instance:instance}:
    set kind to node's kind
    if (((((kind = 2) or (kind = 17)) or ((kind = 19) or (kind = 29))) or ((kind = 33) or (kind = 34))) or ((kind = 35) or (kind = 38))) or ((kind = 43) or (the UI element node is a text control)):
        return true
    if kind = the UI range kind:
        return true
    return (the UI handler for node in instance for event 0) != @intrinsic("construct", a pointer to UI handler)

to get the UI element {UI reference:node} is interactive in {a pointer to UI instance:instance}:
    return (the UI element node has input in instance) and (the UI element node is enabled in instance)

to set UI control {UI reference:node} enabled {boolean:enabled} in {a pointer to UI instance:instance}:
    require condition (the UI element node has input in instance) reporting "Only input controls can be enabled or disabled"
    set entry to the UI value for node in instance
    if entry's enabled != enabled:
        set entry's enabled to enabled
        invalidate instance

to set the {C string:label} control in {a pointer to UI instance:instance} enabled {boolean:enabled}:
    set UI control (the control labeled label in instance) enabled enabled in instance

to get [the UI element] {UI reference:node} [accepts edits in] {a pointer to UI instance:instance}:
    if (the UI element node is a text control) = false:
        return false
    set value to the UI value for node in instance
    return value's enabled and ((value's read only = false) and (value's text protected = false))

to [set UI control] {UI reference:node} [read only] {boolean:locked} [in] {a pointer to UI instance:instance}:
    require condition (the UI element node is a text control) reporting "Only text controls have a read-only policy"
    set value to the UI value for node in instance
    if value's read only != locked:
        set value's read only to locked
        invalidate instance

to [set UI control] {UI reference:node} [text protected] {boolean:locked} [in] {a pointer to UI instance:instance}:
    require condition (the UI element node is a text control) reporting "Only text controls have content protection"
    set value to the UI value for node in instance
    if value's text protected != locked:
        set value's text protected to locked
        invalidate instance

to activate {UI reference:node} belonging to {UI reference:parent} in {a pointer to UI instance:instance}:
    if (the UI element node is enabled in instance) = false:
        return nothing
    set target to node
    if node's kind = 17:
        set entry to the UI value for node in instance
        set entry's number to 1 - entry's number
    if (node's kind = 19) or (node's kind = 29):
        set target to parent
        set index to 0
        loop while (the UI child at index in parent) != node:
            increment index
        set entry to the UI value for parent in instance
        set entry's number to index
    set handler to the UI handler for target in instance for event 0
    if handler != @intrinsic("construct", a pointer to UI handler):
        invoke UI handler handler for node in instance receiving instance
    invalidate instance
