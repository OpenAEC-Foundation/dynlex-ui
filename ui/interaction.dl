# Popup content belongs to the description. Views own capture and focus only.
import view.dl
import ribbon_scroll.dl

to dismiss the UI popup in {a pointer to UI view:view}:
    set view's popup to @intrinsic("construct", a pointer to UI layout)
    set view's pressed to @intrinsic("construct", a pointer to UI layout)

to activate UI layout {a pointer to UI layout:layout} in {a pointer to UI view:view}:
    set node to layout's node
    if node's kind = 39:
        return nothing
    if node's kind = 38:
        set ribbon to the UI layout for element (layout's parent) in (view's layout)
        set tab to the active UI tab in ribbon for (view's instance)
        scroll ribbon tab tab in direction (node's columns) within (the ribbon viewport width for tab in ribbon)
        return nothing
    if node's kind = 35:
        require condition (view's popup != @intrinsic("construct", a pointer to UI layout)) reporting "A menu item was activated without its popup"
        set owner to view's popup
        require condition (layout's parent = owner's node) reporting "The menu item belongs to another popup"
        if owner's node's kind = 34:
            set value to the UI value for (owner's node) in (view's instance)
            select UI option (view's popup index) from (owner's node) into value
            activate (owner's node) belonging to (owner's parent) in (view's instance)
        else:
            activate node belonging to (layout's parent) in (view's instance)
        set view's focus order to owner's order
        dismiss the UI popup in view
        return nothing
    if ((node's kind = 33) or (node's kind = 34)) and (node's count > 0):
        if view's popup = layout:
            dismiss the UI popup in view
        else:
            set view's popup to layout
            set view's popup index to 0
            if node's kind = 34:
                set view's popup index to (the UI value for node in (view's instance))'s number
        return nothing
    activate node belonging to (layout's parent) in (view's instance)

to handle UI popup keys in {a pointer to UI view:view}:
    if view's popup = @intrinsic("construct", a pointer to UI layout):
        return nothing
    if view's key press = 256:
        ignore the UI close key was pressed in view
        return nothing
    set direction to 0
    if view's key press = 265:
        set direction to -1
    if view's key press = 264:
        set direction to 1
    if direction != 0:
        set count to view's popup's node's count
        set view's popup index to ((view's popup index + direction) + count) mod count
        set view's keyboard focus to true
        set view's key press to -1
    if view's key press = 257:
        set child to view's popup's first
        set index to 0
        loop while index < view's popup index:
            set child to child's next
            increment index
        activate UI layout child in view
        set view's key press to -1

to get the UI close key was pressed in {a pointer to UI view:view}:
    if view's key press != 256:
        return false
    set view's key press to -1
    if view's popup != @intrinsic("construct", a pointer to UI layout):
        dismiss the UI popup in view
        return false
    return true

to scroll UI ribbons in {a pointer to UI layout:layout} at {UI point:cursor} in {a pointer to UI view:view}:
    if layout's node's kind = 28:
        set box to layout's painted bounds
        if cursor is inside box:
            set tab to the active UI tab in layout for (view's instance)
            set limit to the ribbon scroll limit for tab within (the ribbon viewport width for tab in layout)
            set destination to the minimum of limit and (the maximum of 0.0 and (tab's scroll target + view's scroll x + view's scroll y))
            if destination != tab's scroll target:
                set tab's scroll target to destination
                set view's damaged to true
    else:
        set child to layout's first
        loop while child != @intrinsic("construct", a pointer to UI layout):
            scroll UI ribbons in child at cursor in view
            set child to child's next
