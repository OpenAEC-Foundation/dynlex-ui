import source_edits.dl

to get [UI source text] {string:left} [precedes] {string:right}:
    set index to 0
    loop while (index < left's length) and (index < right's length):
        set first to (the character at index in left) as an 8 bit unsigned integer
        set second to (the character at index in right) as an 8 bit unsigned integer
        if first != second:
            return first < second
        increment index
    return left's length < right's length

to get [the UI completion sort key of] {a pointer to JSON value:item}:
    if item has JSON member named "sortText":
        return the JSON text named "sortText" in item
    return the JSON text named "label" in item

to get [UI source completion items from] {a pointer to JSON value:result}:
    if result's kind = the JSON null kind:
        return a new JSON-RPC array
    set array to result
    if result's kind = the JSON object kind:
        set array to the JSON member named "items" in result
    require condition (array's kind = the JSON array kind) reporting "Completion must return a list of items"
    set items to a copy of JSON-RPC node array
    set index to 1
    loop while index < items's length:
        set item to the JSON value at index index in items
        set key to the UI completion sort key of item
        set cursor to index
        set searching to true
        loop while (cursor > 0) and searching:
            set previous to the JSON value at index (cursor - 1) in items
            if UI source text key precedes (the UI completion sort key of previous):
                store previous into (items's items) at cursor
                decrement cursor
            else:
                set searching to false
        store item into (items's items) at cursor
        increment index
    return items

to get [the UI source word before byte] {integer:caret} [in] {string:source}:
    set start to caret
    set searching to true
    loop while (start > 0) and searching:
        set previous to the previous UTF8 boundary before start in source
        set code to (the UTF8 character at previous in source)'s code
        if (code <= 32) or (((code = 34) or (code = 39)) or (((code = 40) or (code = 41)) or ((code = 91) or (code = 93)))):
            set searching to false
        else if (((code = 123) or (code = 125)) or ((code = 58) or (code = 44))) or (code = 61):
            set searching to false
        else:
            set start to previous
    return start

to get [the UI source completion change for] {a pointer to JSON value:item} [at byte] {integer:caret} [in] {a pointer to UI source document:document}:
    set edits to a new JSON-RPC array
    if item has JSON member named "textEdit":
        set edit to the JSON member named "textEdit" in item
        if edit has JSON member named "range":
            add (a copy of JSON-RPC node edit) to the JSON array edits
        else:
            add (a JSON object containing [JSON child "range" is (a copy of JSON-RPC node (the JSON member named "replace" in edit)), JSON text "newText" is (the JSON text named "newText" in edit)]) to the JSON array edits
    else:
        set text to the JSON text named "label" in item
        if item has JSON member named "insertText":
            set text to the JSON text named "insertText" in item
        set start to the UI analysis position for source byte (the UI source word before byte caret in (document's source)) in document
        set end to the UI analysis position for source byte caret in document
        add (a JSON object containing [JSON child "range" is (a JSON object containing [JSON child "start" is start, JSON child "end" is end]), JSON text "newText" is text]) to the JSON array edits
    if item has JSON member named "additionalTextEdits":
        set additional to the JSON member named "additionalTextEdits" in item
        set index to 0
        loop while index < additional's length:
            add (a copy of JSON-RPC node (the JSON value at index index in additional)) to the JSON array edits
            increment index
    set change to a UI source change for document applying edits with caret caret
    free edits
    return change
