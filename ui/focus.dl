# Keyboard focus is input state; painting never decides which control receives a key.
import view.dl
import ribbon_scroll.dl
import text.dl
import layout_visibility.dl

to append UI focus {a pointer to UI layout:layout} in {a pointer to UI view:view}:
    if (the UI element (layout's node) is enabled in (view's instance)) = false:
        return nothing
    increment view's control count
    set layout's order to view's control count
    set layout's focus next to @intrinsic("construct", a pointer to UI layout)
    if view's focus last = @intrinsic("construct", a pointer to UI layout):
        set view's focus first to layout
    else:
        set view's focus last's focus next to layout
    set view's focus last to layout

to collect UI focus from {a pointer to UI layout:layout} in {a pointer to UI view:view}:
    set kind to layout's node's kind
    if (the UI layout layout is visible in (view's instance)) = false:
        return nothing
    if kind = 22:
        if layout's node != view's instance's page:
            return nothing
    if kind = 28:
        set child to layout's first
        set index to 0
        loop while index < layout's node's count:
            append UI focus child in view
            set child to child's next
            increment index
        set earlier to child
        set later to child's next
        set active to the active UI tab in layout for (view's instance)
        set child to active's first
        loop while child != @intrinsic("construct", a pointer to UI layout):
            collect UI focus from child in view
            set child to child's next
        if UI ribbon arrow earlier is visible in (view's layout) for (view's instance):
            append UI focus earlier in view
        if UI ribbon arrow later is visible in (view's layout) for (view's instance):
            append UI focus later in view
        return nothing
    if kind = 49:
        set selected to the selected UI child of (layout's node) in (view's instance)
        set child to layout's first
        loop while child's node != selected:
            set child to child's next
        collect UI focus from child in view
        return nothing
    if kind = 48:
        set layout's order to 0
        set active to the selected tab of (layout's node) in (view's instance)
        set child to layout's first
        loop while child's node != active:
            set child to child's next
        set header to child
        if (the UI element (header's node) is enabled in (view's instance)) = false:
            set header to layout's first
            loop while header != @intrinsic("construct", a pointer to UI layout):
                if the UI element (header's node) is enabled in (view's instance):
                    append UI focus header in view
                    set layout's order to header's order
                    set header to @intrinsic("construct", a pointer to UI layout)
                else:
                    set header to header's next
        else:
            append UI focus header in view
            set layout's order to header's order
        set child to child's first
        loop while child != @intrinsic("construct", a pointer to UI layout):
            collect UI focus from child in view
            set child to child's next
        return nothing
    if (((((kind = 2) or (kind = 17)) or ((kind = 19) or (kind = 29))) or ((kind = 33) or (kind = 34))) or (kind = 43)) or (the UI element (layout's node) is a text control):
        append UI focus layout in view
        return nothing
    if kind = the UI range kind:
        append UI focus layout in view
        return nothing
    set child to layout's first
    loop while child != @intrinsic("construct", a pointer to UI layout):
        collect UI focus from child in view
        set child to child's next

to reconcile UI editing focus in {a pointer to UI view:view}:
    set element to @intrinsic("construct", UI reference)
    if view's keyboard focus and (view's focused != @intrinsic("construct", a pointer to UI layout)):
        set node to view's focused's node
        if the UI element node is a text control:
            set element to node
    set changed to element != view's text focus
    set view's text focus to element
    if element = @intrinsic("construct", UI reference):
        set source to view's selection's caret source
        if source != @intrinsic("construct", a pointer to UI text source):
            if source's element != @intrinsic("construct", UI reference):
                clear UI selection in view
                set view's damaged to true
        return nothing
    set source to the address of (view's focused's text source)
    set source's element to element
    if changed and (view's selection's caret source != source):
        set source's text to (the UI value for element in (view's instance))'s text
        set view's selection's anchor source to source
        set view's selection's caret source to source
        set view's selection's anchor to source's text's length
        set view's selection's caret to source's text's length
        set view's selection's vertical to false
        set view's reveal caret to true
        set view's damaged to true
    if view's selection's caret source = source:
        synchronize editable UI text source in view

to refresh UI focus in {a pointer to UI view:view}:
    # Ordinals express keyboard navigation, but inserting or removing another
    # control must preserve the identity of the current focus target.
    set retained to @intrinsic("construct", a pointer to UI layout)
    if view's focused != @intrinsic("construct", a pointer to UI layout):
        if (view's focused's order > 0) and (view's focus order = view's focused's order):
            set retained to view's focused
    set previous to view's focus first
    loop while previous != @intrinsic("construct", a pointer to UI layout):
        set next to previous's focus next
        set previous's order to 0
        set previous's focus next to @intrinsic("construct", a pointer to UI layout)
        set previous to next
    set view's focus first to @intrinsic("construct", a pointer to UI layout)
    set view's focus last to @intrinsic("construct", a pointer to UI layout)
    set view's control count to 0
    collect UI focus from (view's layout) in view
    if retained != @intrinsic("construct", a pointer to UI layout):
        if retained's order > 0:
            set view's focus order to retained's order
    if view's focus order > view's control count:
        set view's focus order to 1
    set view's focused to view's focus first
    loop while view's focused != @intrinsic("construct", a pointer to UI layout):
        if view's focused's order = view's focus order:
            reconcile UI editing focus in view
            return nothing
        set view's focused to view's focused's focus next
    reconcile UI editing focus in view
