import overlays.dl
import source_queries.dl
import source_navigation_types.dl
import source_hover_types.dl
import choice_popovers.dl

class:
    patterns:
        UI source tools
    members:
        workspace as a pointer
        view as a pointer to UI view
        overlay as a pointer to UI overlay
        node as UI reference
        document as a pointer to UI source document
        source as a string
        query as a pointer to UI source query
        items as a pointer to JSON value
        generation as an integer
        mode as an integer
        position as an integer
        choices as UI choice popover
        edited as a boolean
        composed as a boolean
        deadline as a floating-point number
        navigation as UI source navigation
        hover as UI source hover
        selection key as a string
        selection query as a pointer to UI source query
        selection document as a pointer to UI source document
        selection generation as an integer

to [dismiss UI source tools] {a pointer to UI source tools:tools}:
    if (tools's mode = 0) and (tools's query = @intrinsic("construct", a pointer to UI source query)):
        return nothing
    if tools's query != @intrinsic("construct", a pointer to UI source query):
        cancel UI source query (tools's query)
    set tools's query to @intrinsic("construct", a pointer to UI source query)
    set tools's mode to 0
    clear UI choice popover (the address of (tools's choices)) in (tools's view)
    free tools's items
    set tools's items to a new JSON-RPC array
    set tools's view's damaged to true

to [begin UI source interaction in] {a pointer to UI source tools:tools}:
    dismiss UI source tools tools
    cancel UI source navigation (the address of (tools's navigation))
    dismiss UI source hover (the address of (tools's hover)) in (tools's view)
    set tools's edited to false
    set tools's composed to false

to [free UI source tools] {a pointer to UI source tools:tools}:
    if tools = @intrinsic("construct", a pointer to UI source tools):
        return nothing
    if tools's view != @intrinsic("construct", a pointer to UI view):
        dismiss UI source hover (the address of (tools's hover)) in (tools's view)
        clear UI text popover (the address of (tools's hover's popover)) in (tools's view)
        detach UI overlay (tools's overlay) in (tools's view)
    cancel UI source navigation (the address of (tools's navigation))
    release UI choices in (the address of (tools's choices))
    free tools's items
    destroy the value at tools
    deallocate tools
