# Background layers retain their own source identity without changing text colors.
import text_mark_layers.dl
import shapes.dl

to [draw UI text mark layer] {a pointer to UI text mark layer:layer} [in] {string:text} [from] {integer:start} [through] {integer:finish} [in] {a pointer to UI layout:layout} [at] {floating-point number:left} {floating-point number:baseline} [on] {UI frame:frame}:
    set changed to (@intrinsic("equal", the data of (layer's painted text), the data of text)) = false
    set changed to changed or (layer's painted text's length != text's length)
    if (layer's paint generation != frame's view's paint count) or changed:
        set layer's paint generation to frame's view's paint count
        set layer's painted text to text
        set layer's painted matches to layer's text = text
        set layer's painted cursor to layer's marks
    else if start <= layer's painted start:
        set layer's painted cursor to layer's marks
    set layer's painted start to start
    if layer's painted matches = false:
        return nothing
    set mark to layer's painted cursor
    loop while mark != @intrinsic("construct", a pointer to UI text mark):
        if mark's end > start:
            set layer's painted cursor to mark
            set first to the maximum of start and (mark's start)
            set last to the minimum of finish and (mark's end)
            if last > first:
                set x to left + (the width of (the substring of text from start spanning (first - start) bytes) using (layout's typeface))
                set width to the width of (the substring of text from first spanning (last - first) bytes) using (layout's typeface)
                set {font height} to the height of UI font (layout's typeface)
                set height to the maximum of {font height} and (layout's typeface's size * layout's appearance's line spacing)
                set top to (baseline - layout's typeface's ascent) - (height - {font height}) / 2.0
                set box to UI box at x top sized width height
                draw a rounded UI surface box with radius 2.0 from (mark's ink) to (mark's ink) opacity (mark's opacity) feathered by 0.25 on frame
            if mark's end >= finish:
                return nothing
        set mark to mark's next
        set layer's painted cursor to mark

to [draw UI text marks in] {string:text} [from] {integer:start} [through] {integer:finish} [in] {a pointer to UI layout:layout} [at] {floating-point number:left} {floating-point number:baseline} [on] {UI frame:frame}:
    set value to the UI value for (layout's node) in (frame's view's instance)
    set layer to value's mark layers
    loop while layer != @intrinsic("construct", a pointer to UI text mark layer):
        draw UI text mark layer layer in text from start through finish in layout at left baseline on frame
        set layer to layer's next
