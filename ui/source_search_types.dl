import text_search_model.dl
import text_mark_layers.dl
import text_input.dl

class:
    patterns:
        UI source search
    members:
        model as UI text search
        visible as a boolean
        replacing as a boolean
        generation as an integer
        selected as an integer
        error as a string

to get [clear UI search marks from] {a pointer to UI text state:state}:
    set changed to clear UI text marks in layer "editor search" in state
    return (clear UI text marks in layer "editor match" in state) or changed

to [hide UI search controls within] {UI reference:pane} [in] {a pointer to UI view:view}:
    for each label in ["Find text", "Replace text"]:
        set node to the UI element labeled label in pane
        set layout to the UI layout for element node in (view's layout)
        forget UI text source (the address of (layout's text source)) in view
    set panel to the UI element labeled "Search tools" in pane
    set (the UI value for panel in (view's instance))'s number to 0
    invalidate view's instance
