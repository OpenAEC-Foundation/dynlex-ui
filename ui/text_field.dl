import shapes.dl
import clipping.dl
import composition_rendering.dl
import text_geometry.dl
import document_scrolling.dl

to draw UI text field {a pointer to UI layout:layout} in {UI bounds:box} focused {boolean:focused} in {a pointer to UI view:view} on {UI frame:frame}:
    set value to the UI value for (layout's node) in (view's instance)
    set border to view's theme's outline
    if (focused and view's keyboard focus) or (layout's hover > 0.0):
        set border to view's theme's accent
    draw a rounded UI box box with radius 8.0 in border on frame
    draw a rounded UI box (UI box at (box's x + 1.0) (box's y + 1.0) sized (box's width - 2.0) (box's height - 2.0)) with radius 7.0 in (view's theme's surface) on frame
    set clip to UI box at (box's x + 10.0) (box's y + 3.0) sized (box's width - 20.0) (box's height - 6.0)
    set saved to a UI clip restricted to clip in view on frame
    set layout's text source's element to layout's node
    if view's selection's caret source = (the address of (layout's text source)):
        synchronize editable UI text (the address of (layout's text source)) in view
    set layout's text source's text to value's text
    refresh UI text geometry for (the address of (layout's text source)) in view
    keep the UI caret visible in layout within clip in view
    set view's text source to the address of (layout's text source)
    set view's text offset to 0
    set view's text end caret to true
    set view's selectable to true
    set left to clip's x - layout's text scroll
    set baseline to box's y + ((box's height + view's typeface's size) / 2.0 - 2.0)
    if view's selection's composing and (view's selection's caret source = (the address of (layout's text source))):
        ignore draw composing UI row (layout's lines) in layout at left baseline starting with (@intrinsic("construct", a pointer to UI text color span)) on frame
    else:
        ignore draw colored UI row (layout's lines) in layout at left baseline starting with (@intrinsic("construct", a pointer to UI text color span)) on frame
    set view's text source to @intrinsic("construct", a pointer to UI text source)
    set view's selectable to false
    restore UI clip saved in view on frame
