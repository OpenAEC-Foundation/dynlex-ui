# The language server returns plain signatures or Markdown code descriptions.
# Preserve literal bytes inside code; remove only paired presentation delimiters.
import lib/json_builders.dl

to get [the UI code delimiter length at] {integer:start} [in] {string:text}:
    set end to start
    loop while end < text's length:
        if (the character at end in text) != 96:
            return end - start
        increment end
    return end - start

to get [the closing UI code delimiter of length] {integer:count} [after] {integer:start} [in] {string:text}:
    set index to start
    loop while index < text's length:
        if (the character at index in text) = 10:
            return -1
        set length to the UI code delimiter length at index in text
        if length = count:
            return index
        set index to index + (the maximum of 1 and length)
    return -1

to get [the UI code line ending after] {integer:start} [in] {string:text}:
    set index to start
    loop while index < text's length:
        set character to the character at index in text
        increment index
        if character = 10:
            return index
    return index

to get [the UI code line is empty after] {integer:start} [in] {string:text}:
    set index to start
    loop while index < text's length:
        set character to the character at index in text
        if (character = 10) or (character = 13):
            return true
        if (character != 32) and (character != 9):
            return false
        increment index
    return true

to get [UI code text from] {integer:start} [to] {integer:end} [in] {string:text} [contains only spaces]:
    set index to start
    loop while index < end:
        if (the character at index in text) != 32:
            return false
        increment index
    return true

to get [UI code Markdown as text] {string:text}:
    set result to a new string buffer containing (text's length) bytes
    set index, written and fence to 0
    loop while index < text's length:
        set length to the UI code delimiter length at index in text
        set line to index = 0
        if index > 0:
            set line to (the character at (index - 1) in text) = 10
        set boundary to line and (length >= 3)
        if (fence > 0) and boundary:
            set boundary to (length >= fence) and (the UI code line is empty after (index + length) in text)
        if boundary:
            set fence to length if (fence = 0), else 0
            set index to the UI code line ending after index in text
        else if (fence = 0) and (length > 0):
            set closing to the closing UI code delimiter of length length after (index + length) in text
            if closing >= 0:
                set first to index + length
                set last to closing
                if (first < last) and (((the character at first in text) = 32) and ((the character at (last - 1) in text) = 32)):
                    if (UI code text from first to last in text contains only spaces) = false:
                        increment first
                        decrement last
                loop while first < last:
                    store (the character at first in text) into (the data of result) at written
                    increment first
                    increment written
                set index to closing + length
            else:
                loop while length > 0:
                    store (96 as a byte) into (the data of result) at written
                    increment index
                    increment written
                    decrement length
        else:
            store (the character at index in text) into (the data of result) at written
            increment index
            increment written
    set result's length to written
    store (0 as a byte) into (the data of result) at written
    return result

to get [the UI source hover text of] {a pointer to JSON value:result}:
    if result's kind = the JSON null kind:
        return the string form of ""
    set contents to the JSON member named "contents" in result
    if contents's kind = the JSON text kind:
        return contents's text
    set kind to the JSON text named "kind" in contents
    require condition ((kind = "markdown") or (kind = "plaintext")) reporting "The language server returned an unsupported hover content kind"
    set text to the JSON text named "value" in contents
    if kind = "markdown":
        return UI code Markdown as text text
    return text
