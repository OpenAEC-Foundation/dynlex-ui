# A document is a responsive retained UI description, without desktop chrome.
import components.dl
import tabs.dl

section document {name}:
    declares: name
    result: UI reference
    body:
        children: many UI reference
    value:
        (a UI container of kind 40 containing (the body's children) named name)

section document {name} using {UI appearance reference:appearance}:
    declares: name
    result: UI reference
    body:
        children: many UI reference
    value:
        (a UI container of kind 40 containing (the body's children) named name) wearing appearance

section region {C string:name} using {UI appearance reference:appearance}:
    result: UI reference
    body:
        children: many UI reference
    value:
        (a UI container of kind 41 containing (the body's children) named name) wearing appearance

paragraph {C string:text} using {UI appearance reference:appearance} means: (a UI text component 42 labeled text styled "") wearing appearance
paragraph {C string:name} containing {C string:content} using {UI appearance reference:appearance} means: ((a UI text component 42 labeled name styled "") with initial text content) wearing appearance
words {C string:text} means: a UI text component 46 labeled text styled ""
words {C string:text} using {UI appearance reference:appearance} means: (a UI text component 46 labeled text styled "") wearing appearance

section paragraph {C string:name} using {UI appearance reference:appearance}:
    result: UI reference
    body:
        children: many UI reference
    value:
        (a UI container of kind 42 containing (the body's children) named name) wearing appearance

link {C string:text} to {C string:destination} using {UI appearance reference:appearance} means: ((a UI text component 43 labeled text styled "") leading to destination) wearing appearance
a UI text surface {C string:name} styled {C string:variant} containing {C string:initial} using {UI appearance reference:appearance} means: ((a UI text component 44 labeled name styled variant) with initial text initial) wearing appearance
text surface {C string:name} containing {C string:initial} using {UI appearance reference:appearance} means: a UI text surface name styled "" containing initial using appearance
read only text surface {C string:name} containing {C string:initial} using {UI appearance reference:appearance} means: (text surface name containing initial using appearance) with read only text
text area {C string:name} containing {C string:initial} using {UI appearance reference:appearance} means: ((a UI text component 50 labeled name styled "") with initial text initial) wearing appearance
read only text area {C string:name} containing {C string:initial} using {UI appearance reference:appearance} means: (text area name containing initial using appearance) with read only text
text field {C string:name} containing {C string:initial} using {UI appearance reference:appearance} means: (text field name containing initial) wearing appearance
read only text field {C string:name} containing {C string:initial} using {UI appearance reference:appearance} means: (text field name containing initial using appearance) with read only text
switch {C string:name} using {UI appearance reference:appearance} means: (switch name) wearing appearance
choice {C string:text} means: a UI text component 35 labeled text styled ""

a UI choice field {C string:name} choosing {C string:initial} from {an array:children} using {UI appearance reference:appearance} means: ((a UI component 34 labeled name styled "" at 0 0 sized 0 by 0 containing children) with initial text initial) wearing appearance

section choice field {C string:name} choosing {C string:initial} using {UI appearance reference:appearance}:
    result: UI reference
    body:
        children: many UI reference
    value:
        a UI choice field name choosing initial from (the body's children) using appearance

section choice field {C string:name} choosing {C string:initial}:
    result: UI reference
    body:
        children: many UI reference
    value:
        a UI choice field name choosing initial from (the body's children) using no UI appearance

picture {C string:name} from {C string:path} using {UI appearance reference:appearance} means: ((a UI text component 45 labeled name styled "") leading to path) wearing appearance
surface {C string:name} using {UI appearance reference:appearance} means: (a UI text component 20 labeled name styled "") wearing appearance

section view group {C string:name} using {UI appearance reference:appearance}:
    result: UI reference
    body:
        children: many UI reference
    value:
        (a UI container of kind 49 containing (the body's children) named name) wearing appearance

section when the {C string:label} link is followed:
    receiver: a pointer to UI instance
    returns: nothing
    value:
        bind (the control labeled label in this window) in this window to @intrinsic("deferred body") for event 0
