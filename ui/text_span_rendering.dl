import paragraph_rendering.dl
import text_colors.dl
import text_marks.dl

to get draw colored UI row {a pointer to UI text line:line} in {a pointer to UI layout:layout} at {floating-point number:left} {floating-point number:baseline} starting with {a pointer to UI text color span:span} on {UI frame:frame}:
    set ending to true
    if line's next != @intrinsic("construct", a pointer to UI text line):
        set ending to line's end < line's next's start
    return draw colored UI text (layout's content) from (line's start) through (line's end) in layout at left baseline ending ending starting with span on frame

to get draw colored UI text {string:text} from {integer:start} through {integer:finish} in {a pointer to UI layout:layout} at {floating-point number:left} {floating-point number:baseline} ending {boolean:ending} starting with {a pointer to UI text color span:span} on {UI frame:frame}:
    draw UI text marks in text from start through finish in layout at left baseline on frame
    set offset to start
    set x to left
    set more to true
    loop while more:
        set searching to true
        loop while searching and (span != @intrinsic("construct", a pointer to UI text color span)):
            if span's end > offset:
                set searching to false
            else:
                set span to span's next
        set end to finish
        set ink to layout's appearance's foreground
        if span != @intrinsic("construct", a pointer to UI text color span):
            if span's start > offset:
                set end to the minimum of end and (span's start)
            else:
                set ink to span's ink
                set end to the minimum of end and (span's end)
        set content to the substring of text from offset spanning (end - offset) bytes
        set ink to the UI ink ink displayed for (layout's node) over (layout's appearance's background) in (frame's view's instance)
        set frame's view's text offset to offset
        set frame's view's text end caret to ending and (end = finish)
        draw UI text content at x baseline with (layout's typeface) in ink on frame
        set x to x + (the width of content using (layout's typeface))
        set offset to end
        set more to offset < finish
    return span
