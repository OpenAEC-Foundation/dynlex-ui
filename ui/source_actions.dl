# Diagnostic actions share the source request lifecycle and the ordinary choice UI.
import source_inspection.dl
import source_transactions.dl
import source_completion_tools.dl

to get [UI source action diagnostics within] {a pointer to JSON value:range} [in] {a pointer to UI source document:document}:
    set diagnostics to a new JSON-RPC array
    if (document's diagnostic revision != document's revision) or (document's diagnostic project revision != document's project's revision):
        return diagnostics
    set source to document's prefix + document's source
    scan lines in source and set scanned to it
    require condition (scanned succeeded) reporting "The editor source is not valid UTF-8"
    set lines to the line index of scanned
    set absolute to the UI analysis span of range in source indexed by lines
    set selection to the UI source span from (absolute's start) to (absolute's end) in document
    set index to 0
    loop while (index < document's diagnostics' length) and (selection's visible):
        set diagnostic to the JSON value at index index in (document's diagnostics)
        set span to the UI source range of diagnostic in document using source indexed by lines
        if (span's visible) and ((span's start <= selection's end) and (span's end >= selection's start)):
            add (a copy of JSON-RPC node diagnostic) to the JSON array diagnostics
        increment index
    free lines
    return diagnostics

to [refresh UI source fix parameters] {a pointer to UI source query:query} [in] {a pointer to UI source document:document}:
    set range to the JSON member named "range" in (query's parameters)
    set diagnostics to UI source action diagnostics within range in document
    set context to the JSON member named "context" in (query's parameters)
    set JSON member (JSON child "diagnostics" is diagnostics) in context

to [request UI source fixes in] {a pointer to UI source tools:tools}:
    set view to tools's view
    set value to the UI value for (tools's node) in (view's instance)
    if (value's enabled = false) or (value's read only):
        dismiss UI source tools tools
        set tools's edited to false
        return nothing
    set editor to the UI source editor in tools
    remember the UI source location of editor in view
    set document to tools's document
    set first to the minimum of (editor's current's anchor) and (editor's current's caret)
    set last to the maximum of (editor's current's anchor) and (editor's current's caret)
    set range to a JSON object containing [JSON child "start" is (the UI analysis position for source byte first in document), JSON child "end" is (the UI analysis position for source byte last in document)]
    set diagnostics to UI source action diagnostics within range in document
    set context to a JSON object containing [JSON child "diagnostics" is diagnostics, JSON number "triggerKind" is 1, JSON child "only" is (a JSON array containing [a new JSON-RPC text for "quickfix"])]
    set parameters to a JSON object containing [JSON child "textDocument" is (an LSP text document identifier for (document's uri)), JSON child "range" is range, JSON child "context" is context]
    request UI source inspection "textDocument/codeAction" with parameters as mode 5 reporting "Finding fixes…" in tools
    set tools's query's parameters factory to (the function named "refresh UI source fix parameters $ in $") as a pointer
    free parameters

to [collect UI source fix choices in] {a pointer to UI source tools:tools}:
    free tools's items
    set result to tools's query's result
    set tools's items to a new JSON-RPC array
    if result's kind != the JSON null kind:
        require condition (result's kind = the JSON array kind) reporting "Code actions must return an array"
        free tools's items
        set tools's items to a copy of JSON-RPC node result
    clear UI choice popover (the address of (tools's choices)) in (tools's view)
    set index to 0
    loop while index < tools's items's length:
        set item to the JSON value at index index in (tools's items)
        set label to the JSON text named "title" in item
        set enabled to (item has JSON member named "disabled") = false
        if enabled = false:
            set label to (label + " · ") + (the JSON text named "reason" in (the JSON member named "disabled" in item))
        add UI choice label enabled enabled to (the address of (tools's choices))
        increment index
    set hint to (the string form of "↑ ↓ choose · Enter apply · Esc close") if (tools's choices' selected >= 0), else (the string form of "Esc close")
    show UI choice popover (the address of (tools's choices)) reporting "No fixes at this selection." with hint hint in (tools's view)

to [accept UI source fix in] {a pointer to UI source tools:tools}:
    set editor to the UI source editor in tools
    synchronize UI source workspace (editor's workspace) at (tools's view's seconds) seconds
    if (tools's query is current for UI source document (tools's document)) = false:
        dismiss UI source tools tools
        return nothing
    set item to the JSON value at index (tools's choices' selected) in (tools's items)
    set command to a new JSON-RPC null
    if item has JSON member named "command":
        set member to the JSON member named "command" in item
        free command
        if member's kind = the JSON text kind:
            set command to a copy of JSON-RPC node item
        else:
            set command to a copy of JSON-RPC node member
    set accepted to true
    set reason to the string form of ""
    if item has JSON member named "edit":
        set transaction to a UI source transaction applying (the JSON member named "edit" in item) for editor in (tools's view)
        set accepted to commit UI source transaction (the address of transaction) in (tools's view)
        set reason to transaction's reason
        free UI source transaction (the address of transaction)
    else:
        require condition (command's kind != the JSON null kind) reporting "A code action has neither an edit nor a command"
        set value to the UI value for (editor's node) in (tools's view's instance)
        if (value's enabled = false) or (value's read only):
            set accepted to false
            set reason to "This editor is disabled or read only."
    if accepted = false:
        report UI source tools tools saying reason
    else:
        dismiss UI source tools tools
        if command's kind != the JSON null kind:
            execute UI source command command in tools
    free command
