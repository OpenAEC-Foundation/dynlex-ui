# Source linkage and reflected inputs are shared by every programmable scene.
import shader_types.dl
import lib/json_rpc_values.dl

class:
    patterns:
        UI shader linkage
    members:
        program as a pointer to JSON value
        error as a string

{UI shader linkage:result} succeeded means: result's program != @intrinsic("construct", a pointer to JSON value)
{UI shader linkage:result} failed means: result's program = @intrinsic("construct", a pointer to JSON value)

to get [a failed UI shader linkage reporting] {C string:message}:
    return @intrinsic("construct", UI shader linkage, @intrinsic("construct", a pointer to JSON value), the string form of message)

to get [a successful UI shader linkage to] {a pointer to JSON value:program}:
    return @intrinsic("construct", UI shader linkage, program, the string form of "")

to get [UI shader program] {a pointer to JSON value:program} [uses input] {C string:name}:
    set passes to the JSON member named "passes" in program
    set index to 0
    loop while index < passes's length:
        set uniforms to the JSON member named "uniforms" in (the JSON value at index index in passes)
        set cursor to 0
        loop while cursor < uniforms's length:
            if (the JSON text named "name" in (the JSON value at index cursor in uniforms)) = name:
                return true
            increment cursor
        increment index
    return false

to get [the linked UI shader stage] {a pointer to JSON value:stage} [stored as] {C string:kind}:
    return a JSON object containing [
        JSON child "webgpu" is (a JSON object containing [JSON text "kind" is kind, JSON text "value" is (the JSON text named "webgpu" in stage)]),
        JSON child "webgl" is (a JSON object containing [JSON text "kind" is kind, JSON text "value" is (the JSON text named "webgl" in stage)])
    ]

to get [the error from merging UI shader bindings from] {a pointer to JSON value:stage} [into] {a pointer to JSON value:bindings}:
    set uniforms to the JSON member named "uniforms" in stage
    set index to 0
    loop while index < uniforms's length:
        set uniform to the JSON value at index index in uniforms
        set group to the JSON number named "group" in uniform
        set binding to the JSON number named "binding" in uniform
        set name to the JSON text named "name" in uniform
        set cursor to 0
        set found to false
        loop while cursor < bindings's length:
            set existing to the JSON value at index cursor in bindings
            set same to ((the JSON number named "group" in existing) = group) and ((the JSON number named "binding" in existing) = binding)
            if same:
                if (the JSON text named "name" in existing) != name:
                    return "Shader stages disagree about a uniform binding"
                set expected to the JSON member named "type" in existing
                set actual to the JSON member named "type" in uniform
                if ((the JSON text named "scalar" in expected) != (the JSON text named "scalar" in actual)) or (((the JSON number named "rows" in expected) != (the JSON number named "rows" in actual)) or ((the JSON number named "columns" in expected) != (the JSON number named "columns" in actual))):
                    return "Shader stages disagree about a uniform type"
                set found to true
            else:
                if (the JSON text named "name" in existing) = name:
                    return "A shader uniform uses different bindings across stages"
            increment cursor
        if found = false:
            add (a copy of JSON-RPC node uniform) to the JSON array bindings
        increment index
    return ""

{a pointer to JSON value:left} [has the same UI shader slot as] {a pointer to JSON value:right} means: ((the JSON number named "group" in left) = (the JSON number named "group" in right)) and ((the JSON number named "binding" in left) = (the JSON number named "binding" in right))

to get [the error from merging UI shader resources from] {a pointer to JSON value:stage} [into] {a pointer to JSON value:bindings}:
    set resources to the JSON member named "resources" in stage
    set index to 0
    loop while index < resources's length:
        set resource to the JSON value at index index in resources
        set found to false
        set cursor to 0
        loop while cursor < bindings's length:
            set existing to the JSON value at index cursor in bindings
            if existing has the same UI shader slot as resource:
                if ((the JSON text named "name" in existing) != (the JSON text named "name" in resource)) or ((the JSON text named "kind" in existing) != (the JSON text named "kind" in resource)):
                    return "Shader stages disagree about a resource binding"
                if (the JSON text named "kind" in resource) = "texture":
                    if ((the JSON text named "dimension" in existing) != (the JSON text named "dimension" in resource)) or ((the JSON text named "sampleType" in existing) != (the JSON text named "sampleType" in resource)):
                        return "Shader stages disagree about an image type"
                else:
                    if (the JSON boolean named "comparison" in existing) != (the JSON boolean named "comparison" in resource):
                        return "Shader stages disagree about a sampler type"
                set found to true
            else:
                if (the JSON text named "name" in existing) = (the JSON text named "name" in resource):
                    return "A shader resource uses different bindings across stages"
            increment cursor
        if found = false:
            add (a copy of JSON-RPC node resource) to the JSON array bindings
        increment index
    return ""

to get [the error from merging UI shader GLSL metadata] {C string:member} [from] {a pointer to JSON value:stage} [into] {a pointer to JSON value:bindings}:
    set entries to the JSON member named member in stage
    set index to 0
    loop while index < entries's length:
        set entry to the JSON value at index index in entries
        set found to false
        set cursor to 0
        loop while cursor < bindings's length:
            set existing to the JSON value at index cursor in bindings
            if (the JSON text named "name" in existing) = (the JSON text named "name" in entry):
                if (the compact JSON form of existing) != (the compact JSON form of entry):
                    return "Shader stages disagree about a GLSL binding name"
                set found to true
            increment cursor
        if found = false:
            add (a copy of JSON-RPC node entry) to the JSON array bindings
        increment index
    return ""

to get [the error from linking UI shader stage] {a pointer to JSON value:stage} [into pass] {a pointer to JSON value:pass}:
    set error to the error from merging UI shader bindings from stage into (the JSON member named "uniforms" in pass)
    if error = "":
        set error to the error from merging UI shader resources from stage into (the JSON member named "resources" in pass)
    if error = "":
        set error to the error from merging UI shader GLSL metadata "glslBindings" from stage into (the JSON member named "glslBindings" in pass)
    if error = "":
        set error to the error from merging UI shader GLSL metadata "glslUniforms" from stage into (the JSON member named "glslUniforms" in pass)
    return error
