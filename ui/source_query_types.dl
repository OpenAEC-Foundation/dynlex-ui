import lib/json_builders.dl

# Each document owns one bounded slot per feature. A new cursor request replaces
# its slot while an older transport reply may still be in flight.
class:
    patterns:
        UI source query
    members:
        method as a string
        parameters as a pointer to JSON value
        parameters factory as a pointer
        result as a pointer to JSON value
        context as a string
        project as a pointer to UI source project
        project revision as an integer
        revision as an integer
        generation as an integer
        queued as a boolean
        ready as a boolean
        notification as a boolean
        next as a pointer to UI source query

to [cancel UI source query] {a pointer to UI source query:query}:
    increment query's generation
    set query's queued to false
    set query's ready to false

to [cancel UI source queries] {a pointer to UI source query:query}:
    set cursor to query
    loop while cursor != @intrinsic("construct", a pointer to UI source query):
        cancel UI source query cursor
        set cursor to cursor's next

to [free UI source queries] {a pointer to UI source query:query}:
    loop while query != @intrinsic("construct", a pointer to UI source query):
        set next to query's next
        free query's parameters
        free query's result
        destroy the value at query
        deallocate query
        set query to next
