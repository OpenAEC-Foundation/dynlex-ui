# Text runs, UTF-8 boundaries and selection geometry belong to the shared engine.
import platform.dl
import lib/utf8.dl
import input_context.dl

to [exchange UI text state for] {UI reference:node} [in] {a pointer to UI view:view} [with] {a pointer to UI text state:state}:
    set entry to the UI value for node in (view's instance)
    exchange UI text states between (the address of (entry's text state)) and state
    if view's input context's element = node:
        set view's input context's active to false
    set source to view's selection's caret source
    if source != @intrinsic("construct", a pointer to UI text source):
        if source's element = node:
            set view's selection's composing to false
            set view's selection's composition to ""
            set view's selection's vertical to false
    invalidate (view's instance)

to get the UI text boundary at or before {integer:offset} in {string:text}:
    require condition (offset >= 0) reporting "A UI selection offset cannot be negative"
    set position to the minimum of offset and (text's length)
    if position < text's length:
        set octet to ((the character at position in text) as an integer) bitwise and 192
        if octet = 128:
            return the previous UTF8 boundary before position in text
    return position

to clear UI selection in {a pointer to UI view:view}:
    set view's selection to a new UI text selection

to get the UI text prefix of {string:text} ending at {integer:end}:
    return a new string from (the data of text) containing end bytes

to get the [first] selected UI byte in {a pointer to UI text run:run} in {a pointer to UI view:view}:
    set selection to view's selection
    if (selection's anchor source = @intrinsic("construct", a pointer to UI text source)) or (selection's caret source = @intrinsic("construct", a pointer to UI text source)):
        return 0
    set first to selection's anchor source
    set last to selection's caret source
    set start to selection's anchor
    if (first's order > last's order) or ((first = last) and (selection's anchor > selection's caret)):
        set first to selection's caret source
        set last to selection's anchor source
        set start to selection's caret
    if (run's source's order < first's order) or (run's source's order > last's order):
        return 0
    if run's source = first:
        return the minimum of (run's text's length) and (the maximum of 0 and (start - run's start))
    return 0

to get the [last] selected UI byte in {a pointer to UI text run:run} in {a pointer to UI view:view}:
    set selection to view's selection
    if (selection's anchor source = @intrinsic("construct", a pointer to UI text source)) or (selection's caret source = @intrinsic("construct", a pointer to UI text source)):
        return 0
    set first to selection's anchor source
    set last to selection's caret source
    set end to selection's caret
    if (first's order > last's order) or ((first = last) and (selection's anchor > selection's caret)):
        set first to selection's caret source
        set last to selection's anchor source
        set end to selection's anchor
    if (run's source's order < first's order) or (run's source's order > last's order):
        return 0
    if run's source = last:
        return the minimum of (run's text's length) and (the maximum of 0 and (end - run's start))
    return run's text's length

to get the selected UI text in {a pointer to UI view:view}:
    set selection to view's selection
    set first to selection's anchor source
    set last to selection's caret source
    set start to selection's anchor
    set end to selection's caret
    set result to the string form of ""
    if (first = @intrinsic("construct", a pointer to UI text source)) or (last = @intrinsic("construct", a pointer to UI text source)):
        return result
    if (first's order > last's order) or ((first = last) and (start > end)):
        set first to selection's caret source
        set last to selection's anchor source
        set start to selection's caret
        set end to selection's anchor
    set run to view's texts
    set previous to @intrinsic("construct", a pointer to UI text source)
    set included to false
    loop while run != @intrinsic("construct", a pointer to UI text run):
        set source to run's source
        if (run's generation = view's paint count) and (source != previous):
            if (source's order >= first's order) and (source's order <= last's order):
                set left to 0
                set right to source's text's length
                if source = first:
                    set left to start
                if source = last:
                    set right to end
                if included:
                    set result to result + "\n"
                set result to result + (the substring of (source's text) from left spanning (right - left) bytes)
                set included to true
            set previous to source
        set run to run's next
    return result

to get UI text position of {UI point:point} in {a pointer to UI text run:run}:
    return UI point point untransformed by (run's transform)

to get the UI text byte at {floating-point number:x} in {a pointer to UI text run:run}:
    return the UI byte at x in (run's text) using (run's typeface)

to get the UI byte at {floating-point number:x} in {string:content} using {UI font:typeface}:
    set offset to 0
    set width to 0.0
    loop while offset < content's length:
        set character to the UTF8 character at offset in content
        require condition (character's valid) reporting "UI text must contain valid UTF-8"
        set next to the width of (the UI text prefix of content ending at (character's next)) using typeface
        if x < ((width + next) / 2.0):
            return offset
        set width to next
        set offset to character's next
    return offset

to get remember UI [text] {string:text} at {UI point:origin} using {UI font:typeface} on {UI frame:frame}:
    set view to frame's view
    if view's selectable = false:
        return @intrinsic("construct", a pointer to UI text run)
    set run to view's next text
    if run = @intrinsic("construct", a pointer to UI text run):
        set run to storage for one slot initialized with (a new UI text run)
        if view's last text = @intrinsic("construct", a pointer to UI text run):
            set view's texts to run
        else:
            set view's last text's next to run
    set source to view's text source
    set run's paint serial to view's paint serial
    set run's start to view's text offset
    set run's end caret to view's text end caret
    if source = @intrinsic("construct", a pointer to UI text source):
        set source to the address of (run's owned source)
        set run's start to 0
        set run's end caret to true
        if source's text != text:
            if (view's selection's anchor source = source) or (view's selection's caret source = source):
                clear UI selection in view
        set source's text to text
    set run's source to source
    set run's control to view's text control
    set run's text to text
    set run's origin to origin
    set run's typeface to typeface
    set run's transform to view's transform
    set run's clip to view's hit bounds
    increment view's text count
    if source's generation != view's paint count:
        set source's order to view's text count
        set source's generation to view's paint count
    set run's generation to view's paint count
    set view's last text to run
    set view's next text to run's next
    return run

to draw UI selection for {a pointer to UI text run:run} on {UI frame:frame}:
    if run = @intrinsic("construct", a pointer to UI text run):
        return nothing
    set view to frame's view
    if view's selection's composing and (view's selection's caret source = run's source):
        return nothing
    set start to the first selected UI byte in run in view
    set end to the last selected UI byte in run in view
    set x to run's origin's x
    set y to run's origin's y - run's typeface's size
    if end > start:
        set left to the width of (the UI text prefix of (run's text) ending at start) using (run's typeface)
        set right to the width of (the UI text prefix of (run's text) ending at end) using (run's typeface)
        draw a rectangle at x (x + left) and y y with width (right - left) and height (run's typeface's size + 4) in color red 190, green 216 and blue 250 in frame
    if view's active and ((run's source's element != @intrinsic("construct", UI reference)) and (view's selection's caret source = run's source)):
        set caret to view's selection's caret - run's start
        if (caret < 0) or ((caret >= run's text's length) and (run's end caret = false)):
            return nothing
        if caret > run's text's length:
            return nothing
        set offset to the width of (the UI text prefix of (run's text) ending at caret) using (run's typeface)
        position UI input for (run's source) displaying (run's source's text) with caret (view's selection's caret) at (a UI point at (x + offset) and y) using (run's typeface) in view
        draw a rectangle at x (x + offset) and y y with width 1.2 and height (run's typeface's size + 3) in color red 60, green 100 and blue 190 in frame

to finish UI text painting in {a pointer to UI view:view}:
    set run to view's next text
    if view's selection's anchor source != @intrinsic("construct", a pointer to UI text source):
        if (view's selection's anchor source's generation != view's paint count) or (view's selection's caret source's generation != view's paint count):
            clear UI selection in view
    loop while run != @intrinsic("construct", a pointer to UI text run):
        set next to run's next
        destroy the value at run
        deallocate run
        set run to next
    if view's last text = @intrinsic("construct", a pointer to UI text run):
        set view's texts to @intrinsic("construct", a pointer to UI text run)
    else:
        set view's last text's next to @intrinsic("construct", a pointer to UI text run)
    set view's next text to @intrinsic("construct", a pointer to UI text run)

to synchronize editable UI text {a pointer to UI text source:source} in {a pointer to UI view:view}:
    set entry to the UI value for (source's element) in (view's instance)
    if (the UI element (source's element) accepts edits in (view's instance)) = false:
        set view's selection's composing to false
        set view's selection's composition to ""
    if source's text != entry's text:
        set view's selection's composing to false
        set view's selection's composition to ""
        set source's text to entry's text
        set view's selection's anchor to the UI text boundary at or before (view's selection's anchor) in (source's text)
        set view's selection's caret to the UI text boundary at or before (view's selection's caret) in (source's text)

to get the presented UI text of {a pointer to UI text source:source} in {a pointer to UI view:view}:
    if view's selection's composing and (view's selection's caret source = source):
        set selection to view's selection
        return ((the substring of (source's text) from 0 spanning (selection's composition start) bytes) + selection's composition) + (the substring of (source's text) from (selection's composition end) spanning (source's text's length - selection's composition end) bytes)
    return source's text
