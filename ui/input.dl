# Platforms enqueue input; shared DynLex code owns dispatch and interaction.
import events.dl
import invalidation.dl
import lib/utf8.dl

import overlays.dl
import key_bindings.dl

# Kinds: 1 motion, 2 pointer button, 3 key press, 4 text, 5 scroll,
# 6 key release, 7 focus loss, 8 refresh, 9 repeat, 10 composition,
# 11 platform response (key=request ID, modifiers=status), 12 platform notification,
# 13 native text edit (key=input epoch, x/y=UTF-16 selection anchor/caret),
# 14 surface focus gained, 15 pointer cancelled.
# Pointer key: button * 2 + pressed; buttons 0 primary, 1 secondary, 2 middle.
# Scroll key: 0 wheel, 1 touch pan.
# Text input: key=0 typed character, key=1 clipboard.
# Composition: key=input epoch, modifiers=0 end/1 begin/2 update,
# x/y=UTF-16 selection anchor/caret within the composition text.
to [queue UI input of kind] {integer:kind} [key] {integer:key} [at] {floating-point number:x} {floating-point number:y} [with modifiers] {integer:modifiers} [containing] {string:text} [replying to] {a pointer to UI input delivery:delivery} [in] {a pointer to UI view:view}:
    if delivery != @intrinsic("construct", a pointer to UI input delivery):
        require condition (delivery's status != 1) reporting "An input delivery is already queued"
        set delivery's status to 1
        set delivery's handled to false
    set event to @intrinsic("construct", UI input event, kind, key, x, y, modifiers, text, @intrinsic("construct", a pointer to UI input event), delivery)
    set entry to storage for one slot initialized with event
    if view's input first = @intrinsic("construct", a pointer to UI input event):
        set view's input first to entry
    else:
        set view's input last's next to entry
    set view's input last to entry
    @intrinsic("call pointer", view's driver's wake, nothing, view)

to queue UI input of kind {integer:kind} key {integer:key} at {floating-point number:x} {floating-point number:y} with modifiers {integer:modifiers} containing {string:text} in {a pointer to UI view:view}:
    queue UI input of kind kind key key at x y with modifiers modifiers containing text replying to (@intrinsic("construct", a pointer to UI input delivery)) in view

to process UI input in {a pointer to UI view:view}:
    loop while view's input first != @intrinsic("construct", a pointer to UI input event):
        set event to view's input first
        set view's input first to event's next
        set view's input kind to event's kind
        set view's input code to event's key
        set view's input handled to false
        set view's message to event's text
        set view's modifiers to event's modifiers
        set view's key press to -1
        set view's typed text to ""
        set view's scroll x to 0.0
        set view's scroll y to 0.0
        if event's kind = 1:
            set view's cursor to a UI point at (event's x) and (event's y)
        if (event's kind = 2) and (event's key < 2):
            set view's down to event's key = 1
        if ((event's kind = 3) or (event's kind = 9)) or (event's kind = 6):
            require condition (0 <= event's key < 512) reporting "A platform supplied an invalid UI key"
            store (event's kind != 6) into (view's keys) at (event's key)
            if event's kind != 6:
                set view's key press to event's key
        if event's kind = 4:
            set view's typed text to event's text
        if event's kind = 5:
            set view's scroll x to event's x
            set view's scroll y to event's y
        if (event's kind = 7) or (event's kind = 15):
            set view's down to false
            set view's pressed to @intrinsic("construct", a pointer to UI layout)
            set view's selection's dragging to false
            set view's damaged to true
        if event's kind = 7:
            if view's selection's composing:
                receive UI composition (the string form of "") for (view's input context's epoch) at phase 0 selecting 0 through 0 in view
            set view's keys to a new boolean array of 512 items
            set view's active to false
            set view's selection's composition to ""
            set view's selection's composing to false
        if event's kind = 14:
            set view's active to true
            set view's damaged to true
        if event's kind = 8:
            set view's damaged to true
        if event's kind = 10:
            receive UI composition (event's text) for (event's key) at phase (event's modifiers) selecting (event's x as an integer) through (event's y as an integer) in view
        if event's kind = 13:
            receive platform UI text (event's text) for (event's key) selecting (event's x as an integer) through (event's y as an integer) in view
        set consumed to process UI overlays in view
        if consumed = false:
            set consumed to process UI key bindings in view
        if consumed:
            set view's input handled to true
            set view's key press to -1
            set view's typed text to ""
            set view's scroll x and view's scroll y to 0.0
            set view's was down to view's down
            set view's pressed to @intrinsic("construct", a pointer to UI layout)
            if view's selection's limit = @intrinsic("construct", a pointer to UI text source):
                set view's selection's dragging to false
        if consumed = false:
            if view's input action != (0 as a pointer):
                @intrinsic("call pointer", view's input action, nothing, view)
            handle UI input in view
        set view's key press to -1
        set view's typed text to ""
        set view's scroll x to 0.0
        set view's scroll y to 0.0
        if event's delivery != @intrinsic("construct", a pointer to UI input delivery):
            set event's delivery's handled to view's input handled
            set event's delivery's status to 2
        destroy the value at event
        deallocate event
    set view's input last to @intrinsic("construct", a pointer to UI input event)

to watch UI input in {a pointer to UI view:view} using {a callback:action}:
    set view's input action to action as a pointer

to update UI frames in {a pointer to UI view:view} using {a callback:action}:
    set view's frame action to action as a pointer

the UI escape key means: 256
the UI space key means: 32
the UI P key means: 80
the UI W key means: 87
the UI A key means: 65
the UI S key means: 83
the UI D key means: 68
the UI right arrow key means: 262
the UI left arrow key means: 263
the UI down arrow key means: 264
the UI up arrow key means: 265
