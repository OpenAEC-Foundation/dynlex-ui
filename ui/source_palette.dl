# Owned palette snapshots keep color caching independent of caller array lifetimes.
import source_annotations.dl

class:
    patterns:
        UI source palette entry
    members:
        name as a string
        ink as UI paint
        next as a pointer to UI source palette entry

to get [UI source palette] {a pointer to UI source palette entry:palette} [matches] {an array:theme}:
    set cursor to palette
    set index to 0
    loop while index < the length of theme:
        if cursor = @intrinsic("construct", a pointer to UI source palette entry):
            return false
        set style to the item at index in theme
        if (cursor's name != style's name) or (((cursor's ink's red != style's ink's red) or (cursor's ink's green != style's ink's green)) or (cursor's ink's blue != style's ink's blue)):
            return false
        set cursor to cursor's next
        increment index
    return cursor = @intrinsic("construct", a pointer to UI source palette entry)

to get [a UI source palette copying] {an array:theme}:
    set palette to @intrinsic("construct", a pointer to UI source palette entry)
    set index to the length of theme
    loop while index > 0:
        decrement index
        set style to the item at index in theme
        set entry to @intrinsic("construct", UI source palette entry, the string form of (style's name), style's ink, palette)
        set palette to storage for one slot initialized with entry
    return palette

to [free UI source palette] {a pointer to UI source palette entry:palette}:
    loop while palette != @intrinsic("construct", a pointer to UI source palette entry):
        set next to palette's next
        destroy the value at palette
        deallocate palette
        set palette to next
