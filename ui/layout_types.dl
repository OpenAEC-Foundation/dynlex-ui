# Renderer-independent data used to arrange UI descriptions.
import components.dl
import geometry.dl
import document_types.dl
import text_source_types.dl

class:
    patterns:
        UI theme
    members:
        table ink as UI paint
        button ink as UI paint
        border as an integer
        cell width as an integer
        cell height as an integer
        background as UI paint
        surface as UI paint
        outline as UI paint
        text as UI paint
        muted as UI paint
        accent as UI paint
        dark as a boolean

class:
    patterns:
        UI layout
    members:
        node as UI reference
        parent as UI reference
        bounds as UI bounds
        design bounds as UI bounds
        horizontal pin as an integer
        vertical pin as an integer
        scroll position as a floating-point number
        scroll target as a floating-point number
        painted bounds as UI bounds
        hover as a floating-point number
        transition as a floating-point number
        painted as a boolean
        paint generation as an integer
        paint serial as an integer
        hit bounds as UI bounds
        extent as a floating-point number
        order as an integer
        focus next as a pointer to UI layout
        first as a pointer to UI layout
        next as a pointer to UI layout
        appearance as UI appearance settings
        typeface as UI font
        content as a string
        lines as a pointer to UI text line
        text source as UI text source
        text height as a floating-point number
        text width as a floating-point number
        text scroll as a floating-point number
        text start as an integer
        text end as an integer
        rich as a boolean
        tab bounds as UI bounds
        measured selection as UI reference
