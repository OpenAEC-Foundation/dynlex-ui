# Find is an ordinary retained form with ordinary fields and control callbacks.
import document_declarations.dl

appearance UI source search appearance:
    padding is 8
    gap is 6
    font size is 12

appearance UI source search row appearance:
    flow is horizontal
    gap is 6

appearance UI source search field appearance:
    padding is 6
    height is 42
    corner radius is 4
    lines do not wrap

appearance UI source empty appearance:
    padding is 0
    gap is 0
    height is 0
    minimum height is 0

UI source search controls means: (a UI container of kind 49 containing [
    (a UI container of kind 41 containing no UI children named "Search closed") wearing UI source empty appearance,
    (a UI container of kind 41 containing [
        paragraph "Find label" containing "Find in source · Alt+Enter adds a line" using no UI appearance,
        text area "Find text" containing "" using UI source search field appearance,
        (a UI container of kind 49 containing [
            (a UI container of kind 41 containing no UI children named "Replace closed") wearing UI source empty appearance,
            (a UI container of kind 41 containing [
                text area "Replace text" containing "" using UI source search field appearance,
                (a UI container of kind 41 containing [button "Replace", button "Replace all"]) wearing UI source search row appearance
            ]) wearing UI source empty appearance
        ] named "Replace tools") wearing UI source empty appearance,
        (a UI container of kind 41 containing [
            switch "Match case" using no UI appearance,
            switch "Whole words" using no UI appearance
        ]) wearing UI source search row appearance,
        (a UI container of kind 41 containing [
            button "Previous match", button "Next match", button "Replace…", button "Close find"
        ]) wearing UI source search row appearance,
        paragraph "Search result" containing "" using no UI appearance
    ] named "Search panel") wearing UI source search appearance
] named "Search tools") wearing UI source empty appearance
