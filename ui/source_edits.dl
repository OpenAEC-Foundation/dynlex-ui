# The standard edit planner owns ordering, Unicode conversion and application.
# This adapter adds a visible-source boundary, caret mapping and snapshot identity.
import source_annotations.dl
import lib/workspace_edit_parse.dl
import lib/workspace_edit_text.dl

class:
    patterns:
        UI source change
    members:
        succeeded as a boolean
        reason as a string
        text as a string
        caret as an integer
        revision as an integer
        context as a string

to get {UI source change:change} [is current for UI source document] {a pointer to UI source document:document}:
    return (change's revision = document's revision) and (change's context = document's context)

to get [a UI source change for] {a pointer to UI source document:document} [applying] {a pointer to JSON value:edits} [with caret] {integer:caret}:
    require condition (edits's kind = the JSON array kind) reporting "Source edits must be an array"
    require condition (0 <= caret <= document's source's length) reporting "An edit caret is outside the source"
    set boundary to the UTF-16 position of UTF-8 byte offset caret in (document's source)
    require condition (boundary succeeded) reporting "An edit caret splits a Unicode character"
    set result to a new UI source change
    set result's succeeded to true
    set result's text to document's source
    set result's caret to caret
    set result's revision to document's revision
    set result's context to document's context
    set payload to a JSON object containing [JSON child "changes" is (a JSON object containing [JSON child (document's uri) is (a copy of JSON-RPC node edits)])]
    set parsed to the result of parsing payload as a workspace edit
    free payload
    require condition (parsed succeeded) reporting "The language service supplied an invalid text edit"
    set change to the workspace change at index 0 in (parsed's edit's changes)
    set plan to the workspace text edit plan for (change's edits) against (document's prefix + document's source) using the workspace UTF-16 position encoding
    free parsed
    if plan's success = false:
        set result's succeeded to false
        set result's reason to plan's failure reason
    set index and delta to 0
    set mapped to caret
    loop while (index < the count of text edits in plan) and (result's succeeded):
        set start to (the start byte of workspace edit index in plan) - document's prefix's length
        set end to (the end byte of workspace edit index in plan) - document's prefix's length
        set text to the replacement text of workspace edit index in plan
        if (start < 0) or (end > document's source's length):
            set result's succeeded to false
            set result's reason to "This edit changes protected project context."
        set difference to text's length - (end - start)
        if caret >= end:
            set mapped to mapped + difference
        else if caret >= start:
            set mapped to start + delta + text's length
        set delta to delta + difference
        increment index
    if result's succeeded:
        set applied to the result of applying workspace text edit plan plan
        if applied succeeded:
            set result's text to the substring of (applied's text) from (document's prefix's length) spanning (applied's text's length - document's prefix's length) bytes
            set result's caret to mapped
        else:
            set result's succeeded to false
            set result's reason to applied's failure reason
    free workspace text edit plan plan
    return result
