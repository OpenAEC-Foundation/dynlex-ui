# A shared, non-editing list surface. Callers own item payloads and acceptance.
# Input results: 0 passes through, 1 is consumed, 2 activates, 3 dismisses.
import choice_popover_types.dl
import shapes.dl
import clipping.dl

to [paint UI choice popover] {a pointer to UI choice popover:popup} [anchored at] {UI point:anchor} [within] {UI bounds:viewport} [using] {UI font:typeface} [styled] {UI appearance settings:style} [on] {UI frame:frame}:
    set popup's rows to 0
    set popup's bounds to UI box at 0 0 sized 0 0
    retire UI floating layout (the address of (popup's surface))
    if popup's visible = false:
        return nothing
    set popup's row height to the maximum of 28.0 and (typeface's size + 12.0)
    set available to ((viewport's height - 50.0) / popup's row height) as an integer
    if (viewport's width <= 16.0) or (available < 1):
        return nothing
    set view to frame's view
    set width to the minimum of 440.0 and (viewport's width - 16.0)
    set rows to the minimum of 8 and (the minimum of (popup's count) and available)
    set popup's rows to rows
    set height to ((the maximum of 1 and rows) * popup's row height) + 34.0
    set left to the maximum of (viewport's x + 8.0) and (the minimum of (anchor's x) and (((viewport's x + viewport's width) - width) - 8.0))
    set top to anchor's y
    if (top + height) > ((viewport's y + viewport's height) - 8.0):
        set top to (anchor's y - height) - 24.0
    set top to the maximum of (viewport's y + 8.0) and (the minimum of top and (((viewport's y + viewport's height) - height) - 8.0))
    set box to UI box at left top sized width height
    set popup's bounds to box
    record UI floating layout (the address of (popup's surface)) in box on frame
    set background to style's background
    set foreground to style's foreground
    set outline to UI ink between background and foreground at 0.2
    set selected to UI ink between background and foreground at 0.12
    set muted to UI ink between background and foreground at 0.65
    if popup's selected < popup's first:
        set popup's first to the maximum of 0 and (popup's selected)
    if popup's selected >= (popup's first + rows):
        set popup's first to (popup's selected - rows) + 1
    draw a UI shadow under box with radius 7.0 softness 8.0 strength 14 in (UI ink 0 0 0) on frame
    draw a rounded UI box box with radius 7.0 in outline on frame
    draw a rounded UI box (UI box at (left + 1.0) (top + 1.0) sized (width - 2.0) (height - 2.0)) with radius 6.0 in background on frame
    set clip to a UI clip restricted to (UI box at (left + 6.0) (top + 5.0) sized (width - 12.0) (height - 10.0)) in view on frame
    set {previous selectable} to view's selectable
    set view's selectable to false
    set baseline to ((popup's row height + typeface's size) / 2.0) - 2.0
    if rows = 0:
        draw UI text (popup's message) at (left + 12.0) ((top + 6.0) + baseline) with typeface in muted on frame
    set row to 0
    loop while row < rows:
        set index to popup's first + row
        set item to the UI choice at index in popup
        set y to (top + 6.0) + (row * popup's row height)
        if index = popup's selected:
            draw a rounded UI box (UI box at (left + 5.0) y sized (width - 10.0) (popup's row height)) with radius 4.0 in selected on frame
        set ink to foreground if (item's enabled), else muted
        draw UI text (item's label) at (left + 12.0) (y + baseline) with typeface in ink on frame
        increment row
    draw UI text (popup's hint) at (left + 12.0) ((top + height) - 10.0) with (view's small) in muted on frame
    restore UI clip clip in view on frame
    set view's selectable to previous selectable

to get [read UI choice popover] {a pointer to UI choice popover:popup} [in] {a pointer to UI view:view}:
    if popup's visible = false:
        return 0
    if view's key press = 256:
        return 3
    if popup's rows > 0:
        if (view's modifiers = 0) and ((view's key press = 264) or (view's key press = 265)):
            set direction to 1 if (view's key press = 264), else -1
            move UI choice selection in popup by direction wrapping true
            set view's damaged to true
            return 1
        if (view's modifiers = 0) and ((view's key press = 268) or (view's key press = 269)):
            set direction to 1 if (view's key press = 268), else -1
            set popup's selected to -1 if (direction = 1), else (popup's count)
            move UI choice selection in popup by direction wrapping false
            set view's damaged to true
            return 1
        if (view's modifiers = 0) and ((view's key press = 266) or (view's key press = 267)):
            set direction to -1 if (view's key press = 266), else 1
            set remaining to popup's rows
            loop while remaining > 0:
                move UI choice selection in popup by direction wrapping false
                decrement remaining
            set view's damaged to true
            return 1
        if ((view's key press = 257) or ((view's key press = 258) and (popup's accepts tab))) and (popup's selected >= 0):
            return 2
    set cursor to the UI cursor in view
    if cursor is inside (popup's bounds):
        if (view's input kind = 1) or (view's input kind = 2):
            set shape to 0
            set activated to false
            set row to (((cursor's y - popup's bounds' y) - 6.0) / popup's row height) as an integer
            set selected to popup's first + row
            if (cursor's y >= (popup's bounds' y + 6.0)) and ((0 <= row < popup's rows) and (selected < popup's count)):
                if (the UI choice at selected in popup)'s enabled:
                    set popup's selected to selected
                    set view's damaged to true
                    set shape to 1
                    set activated to (view's input kind = 2) and (view's down)
            if view's cursor shape != shape:
                set view's cursor shape to shape
                @intrinsic("call pointer", view's driver's cursor, nothing, view, shape)
            if activated:
                return 2
            return 1
        if view's input kind = 5:
            set direction to 1 if (view's scroll y > 0.0), else -1
            move UI choice selection in popup by direction wrapping false
            set view's damaged to true
            return 1
    if ((view's input kind = 2) and view's down) or (view's key press >= 0):
        return 3
    return 0
