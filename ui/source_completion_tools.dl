import source_workspace.dl
import source_completions.dl
import text_input.dl

to [execute UI source command] {a pointer to JSON value:command} [in] {a pointer to UI source tools:tools}:
    set name to the JSON text named "command" in command
    if name = "editor.action.triggerSuggest":
        request UI source completions in tools
    else:
        set parameters to a JSON object containing [JSON text "command" is name]
        if command has JSON member named "arguments":
            add JSON-RPC member "arguments" containing (a copy of JSON-RPC node (the JSON member named "arguments" in command)) to parameters
        ignore request UI source feature "workspace/executeCommand" with parameters parameters in (tools's document)
        free parameters

to [request UI source completions in] {a pointer to UI source tools:tools}:
    if ((tools's document's writable = false) or (tools's document's available = false)) or ((the UI element (tools's node) accepts edits in (tools's view's instance)) = false):
        dismiss UI source tools tools
        set tools's edited to false
        return nothing
    set tools's position to tools's view's selection's caret
    set tools's generation to 0
    begin UI source interaction in tools
    set tools's query to request UI source feature "textDocument/completion" at byte (tools's position) in (tools's document)
    set tools's mode to 1
    set tools's choices' accepts tab to true
    show UI choice popover (the address of (tools's choices)) reporting "Finding suggestions…" with hint "↑ ↓ choose  ·  Enter insert  ·  Esc close" in (tools's view)
    animate UI view (tools's view)

to [accept the UI source completion in] {a pointer to UI source tools:tools}:
    set query to tools's query
    if (query's ready = false) or ((query is current for UI source document (tools's document)) = false):
        dismiss UI source tools tools
        return nothing
    set item to the JSON value at index (tools's choices' selected) in (tools's items)
    set change to the UI source completion change for item at byte (tools's position) in (tools's document)
    set command to a new JSON-RPC null
    if item has JSON member named "command":
        free command
        set command to a copy of JSON-RPC node (the JSON member named "command" in item)
    if change's succeeded:
        commit UI text (change's text) selecting (change's caret) through (change's caret) in (tools's view)
        edit UI source document (tools's document) to (change's text) at (tools's view's seconds) seconds
    if change's succeeded = false:
        report UI source tools tools saying (change's reason)
    else:
        dismiss UI source tools tools
        if command's kind != the JSON null kind:
            execute UI source command command in tools
    free command

