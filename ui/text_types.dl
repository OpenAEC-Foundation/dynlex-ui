import text_source_types.dl
import layout_types.dl
import platform_types.dl
import transform_types.dl

class:
    patterns:
        UI text run
    members:
        text as a string
        origin as UI point
        typeface as UI font
        transform as UI transform
        clip as UI bounds
        source as a pointer to UI text source
        owned source as UI text source
        start as an integer
        end caret as a boolean
        control as a pointer to UI layout
        layout as a pointer to UI layout
        generation as an integer
        paint serial as an integer
        next as a pointer to UI text run
