# Textured surfaces use the same rounded boundary and coverage as solid shapes.
import shapes.dl

to add textured UI [vertex] {UI point:point} across {UI bounds:box} sampling {UI bounds:sample} in {linear UI paint:ink} with alpha {floating-point number:alpha} to {UI frame:frame}:
    set horizontal to the minimum of 1.0 and (the maximum of 0.0 and ((point's x - box's x) / box's width))
    set vertical to the minimum of 1.0 and (the maximum of 0.0 and ((point's y - box's y) / box's height))
    set vertex to @intrinsic("construct", UI vertex,
        point's x as a 32 bit floating-point number, point's y as a 32 bit floating-point number,
        (sample's x + horizontal * sample's width) as a 32 bit floating-point number, (sample's y + vertical * sample's height) as a 32 bit floating-point number,
        ink's red, ink's green, ink's blue, alpha as a 32 bit floating-point number)
    append UI vertex vertex to frame

to draw UI texture {UI texture:texture} in {UI bounds:box} rounded by {floating-point number:radius} in {UI paint:ink} on {UI frame:frame}:
    draw UI texture texture in box rounded by radius in ink with opacity 255 on frame

to draw UI texture {UI texture:texture} in {UI bounds:box} rounded by {floating-point number:radius} in {UI paint:ink} with opacity {integer:opacity} on {UI frame:frame}:
    draw UI texture texture in box rounded by radius sampling (UI box at 0 0 sized 1 1) in ink with opacity opacity on frame

to draw UI texture {UI texture:texture} in {UI bounds:box} rounded by {floating-point number:radius} sampling {UI bounds:sample} in {UI paint:ink} with opacity {integer:opacity} on {UI frame:frame}:
    if frame's drawable = false:
        return nothing
    set rounding to the minimum of ((the minimum of (box's width) and (box's height)) / 2.0) and (the maximum of 0.5 and radius)
    set steps to the maximum of 5 and (((the square root of (rounding * 2.0)) as an integer) + 3)
    set count to steps * 4
    set center to a UI point at (box's x + box's width / 2.0) and (box's y + box's height / 2.0)
    set paint to the linear UI ink of ink on frame
    set alpha to ((opacity as a floating-point number) / 255.0) * ((frame's view's current alpha as a floating-point number) / 255.0)
    start triangles in frame
    set index to 0
    loop while index < count:
        set next to (index + 1) mod count
        set first to the UI corner point index of steps on box rounded by rounding expanded by -0.5
        set second to the UI corner point next of steps on box rounded by rounding expanded by -0.5
        set {outside first} to the UI corner point index of steps on box rounded by rounding expanded by 0.75
        set {outside second} to the UI corner point next of steps on box rounded by rounding expanded by 0.75
        add textured UI vertex center across box sampling sample in paint with alpha alpha to frame
        add textured UI vertex first across box sampling sample in paint with alpha alpha to frame
        add textured UI vertex second across box sampling sample in paint with alpha alpha to frame
        add textured UI vertex first across box sampling sample in paint with alpha alpha to frame
        add textured UI vertex second across box sampling sample in paint with alpha alpha to frame
        add textured UI vertex outside second across box sampling sample in paint with alpha 0.0 to frame
        add textured UI vertex first across box sampling sample in paint with alpha alpha to frame
        add textured UI vertex outside second across box sampling sample in paint with alpha 0.0 to frame
        add textured UI vertex outside first across box sampling sample in paint with alpha 0.0 to frame
        increment index
    submit UI triangles with texture (texture's resource) on frame

# Feathered ellipse masks composite a detail from the original image without
# replacing its surrounding pixels. UVs remain tied to the full image bounds.
to draw UI texture {UI texture:texture} across {UI bounds:box} sampling {UI bounds:sample} masked by {UI bounds:mask} opaque through {floating-point number:solid} with opacity {integer:opacity} on {UI frame:frame}:
    require condition ((solid >= 0.0) and (solid < 1.0)) reporting "An ellipse mask requires an opaque fraction below one"
    if (frame's drawable = false) or ((mask's width <= 0.0) or (mask's height <= 0.0)):
        return nothing
    set center to a UI point at (mask's x + mask's width / 2.0) and (mask's y + mask's height / 2.0)
    set ink to the linear UI ink of (UI ink 255 255 255) on frame
    set alpha to (opacity / 255.0) * (frame's view's current alpha / 255.0)
    set radiusX to mask's width / 2.0
    set radiusY to mask's height / 2.0
    set index to 0
    start triangles in frame
    loop while index < 48:
        set angle to index * 0.1308996938995747
        set next to (index + 1) * 0.1308996938995747
        set first to a UI point at (center's x + (the cosine of angle) * radiusX) and (center's y + (the sine of angle) * radiusY)
        set second to a UI point at (center's x + (the cosine of next) * radiusX) and (center's y + (the sine of next) * radiusY)
        set {inside first} to a UI point at (center's x + (first's x - center's x) * solid) and (center's y + (first's y - center's y) * solid)
        set {inside second} to a UI point at (center's x + (second's x - center's x) * solid) and (center's y + (second's y - center's y) * solid)
        add textured UI vertex center across box sampling sample in ink with alpha alpha to frame
        add textured UI vertex {inside first} across box sampling sample in ink with alpha alpha to frame
        add textured UI vertex {inside second} across box sampling sample in ink with alpha alpha to frame
        add textured UI vertex {inside first} across box sampling sample in ink with alpha alpha to frame
        add textured UI vertex first across box sampling sample in ink with alpha 0.0 to frame
        add textured UI vertex second across box sampling sample in ink with alpha 0.0 to frame
        add textured UI vertex {inside first} across box sampling sample in ink with alpha alpha to frame
        add textured UI vertex second across box sampling sample in ink with alpha 0.0 to frame
        add textured UI vertex {inside second} across box sampling sample in ink with alpha alpha to frame
        increment index
    submit UI triangles with texture (texture's resource) on frame
