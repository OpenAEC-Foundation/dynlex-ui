# Textured surfaces use the same rounded boundary and coverage as solid shapes.
import shapes.dl

to add textured UI vertex {UI point:point} across {UI bounds:box} in {linear UI paint:ink} with alpha {floating-point number:alpha} to {UI frame:frame}:
    set horizontal to the minimum of 1.0 and (the maximum of 0.0 and ((point's x - box's x) / box's width))
    set vertical to the minimum of 1.0 and (the maximum of 0.0 and ((point's y - box's y) / box's height))
    set sample to @intrinsic("construct", UI vertex,
        point's x as a 32 bit floating-point number, point's y as a 32 bit floating-point number,
        horizontal as a 32 bit floating-point number, vertical as a 32 bit floating-point number,
        ink's red, ink's green, ink's blue, alpha as a 32 bit floating-point number)
    append UI vertex sample to frame

to draw UI texture {UI texture:texture} in {UI bounds:box} rounded by {floating-point number:radius} in {UI paint:ink} on {UI frame:frame}:
    draw UI texture texture in box rounded by radius in ink with opacity 255 on frame

to draw UI texture {UI texture:texture} in {UI bounds:box} rounded by {floating-point number:radius} in {UI paint:ink} with opacity {integer:opacity} on {UI frame:frame}:
    if frame's drawable = false:
        return nothing
    set rounding to the minimum of ((the minimum of (box's width) and (box's height)) / 2.0) and (the maximum of 0.5 and radius)
    set steps to the maximum of 5 and (((the square root of (rounding * 2.0)) as an integer) + 3)
    set count to steps * 4
    set center to a UI point at (box's x + box's width / 2.0) and (box's y + box's height / 2.0)
    set paint to the linear UI ink of ink on frame
    set alpha to ((opacity as a floating-point number) / 255.0) * ((frame's view's current alpha as a floating-point number) / 255.0)
    start triangles in frame
    set index to 0
    loop while index < count:
        set next to (index + 1) mod count
        set first to the UI corner point index of steps on box rounded by rounding expanded by -0.5
        set second to the UI corner point next of steps on box rounded by rounding expanded by -0.5
        set {outside first} to the UI corner point index of steps on box rounded by rounding expanded by 0.75
        set {outside second} to the UI corner point next of steps on box rounded by rounding expanded by 0.75
        add textured UI vertex center across box in paint with alpha alpha to frame
        add textured UI vertex first across box in paint with alpha alpha to frame
        add textured UI vertex second across box in paint with alpha alpha to frame
        add textured UI vertex first across box in paint with alpha alpha to frame
        add textured UI vertex second across box in paint with alpha alpha to frame
        add textured UI vertex outside second across box in paint with alpha 0.0 to frame
        add textured UI vertex first across box in paint with alpha alpha to frame
        add textured UI vertex outside second across box in paint with alpha 0.0 to frame
        add textured UI vertex outside first across box in paint with alpha 0.0 to frame
        increment index
    submit UI triangles with texture (texture's resource) on frame
