import shapes.dl
import animation.dl

to draw UI fragment from {integer:start} to {integer:end} at {floating-point number:x} {floating-point number:baseline} using {a pointer to UI layout:span} in {a pointer to UI layout:paragraph} on {UI frame:frame} ending {boolean:ending}:
    set view to frame's view
    set content to the substring of (paragraph's content) from start spanning (end - start) bytes
    set width to the width of content using (span's typeface)
    set box to UI box at x (baseline - span's typeface's size) sized width (span's typeface's size + 4)
    set appearance to span's appearance
    set view's text control to @intrinsic("construct", a pointer to UI layout)
    if span != paragraph:
        if appearance's filled:
            draw a rounded UI box box with radius 3.0 in (appearance's background) on frame
        if span's node's kind = 43:
            set view's text control to span
            set span's paint serial to view's paint serial
            if span's paint generation != view's paint count:
                set span's painted bounds to box
                set span's paint generation to view's paint count
            else:
                set left to the minimum of (span's painted bounds' x) and (box's x)
                set top to the minimum of (span's painted bounds' y) and (box's y)
                set right to the maximum of (span's painted bounds' x + span's painted bounds' width) and (box's x + box's width)
                set bottom to the maximum of (span's painted bounds' y + span's painted bounds' height) and (box's y + box's height)
                set span's painted bounds to UI box at left top sized (right - left) (bottom - top)
            if (view's hot = span) or ((view's focused = span) and (view's keyboard focus)):
                draw a rectangle at x x and y (baseline + 3.0) with width width and height 1.0 in color red appearance's foreground's red, green appearance's foreground's green and blue appearance's foreground's blue in frame
    set view's text offset to start
    set view's text end caret to ending
    draw UI text content at x baseline with (span's typeface) in (appearance's foreground) on frame
    set view's text control to @intrinsic("construct", a pointer to UI layout)

to draw UI row {a pointer to UI text line:line} in {a pointer to UI layout:layout} at {floating-point number:left} {floating-point number:baseline} on {UI frame:frame}:
    set ending to true
    if line's next != @intrinsic("construct", a pointer to UI text line):
        set ending to line's end < line's next's start
    if (layout's rich = false) or (line's start = line's end):
        draw UI fragment from (line's start) to (line's end) at left baseline using layout in layout on frame ending ending
        return nothing
    set child to layout's first
    set x to left
    loop while child != @intrinsic("construct", a pointer to UI layout):
        set start to the maximum of (line's start) and (child's text start)
        set end to the minimum of (line's end) and (child's text end)
        if end > start:
            draw UI fragment from start to end at x baseline using child in layout on frame ending (ending and (end = line's end))
            set x to x + (the width of (the substring of (layout's content) from start spanning (end - start) bytes) using (child's typeface))
        set child to child's next
