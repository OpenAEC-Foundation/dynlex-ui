import document_layout.dl
import outlines.dl
import animation.dl
import clipping.dl
import document_scrolling.dl
import paragraph_rendering.dl
import document_tabs_rendering.dl
import editor_rendering.dl
import composition_rendering.dl
import control_presentation.dl
import document_forms.dl

to draw document UI layout {a pointer to UI layout:layout} at {floating-point number:x} {floating-point number:y} in {a pointer to UI view:view} on {UI frame:frame}:
    set appearance to the UI appearance of layout displayed in view
    set available to the UI element (layout's node) is enabled in (view's instance)
    if available = false:
        set layout's hover to 0.0
    if (the UI layout layout is visible in (view's instance)) = false:
        return nothing
    set view's text layout to layout
    increment view's paint serial
    set layout's paint serial to view's paint serial
    set box to layout's bounds
    set box's x to box's x + x
    set box's y to box's y + y
    if appearance's sticky:
        set box's y to the maximum of 0.0 and (box's y)
    set layout's painted bounds to box
    set kind to layout's node's kind
    set {text control} to the UI element (layout's node) is a text control
    if appearance's filled or (((((((kind = 2) or (kind = 17)) or (kind = 20)) or (kind = 34)) or (kind = 43)) or text control) or (kind = 45)):
        set layout's paint generation to view's paint count
        set layout's hit bounds to the UI intersection of box and (view's hit bounds)
    if appearance's filled:
        draw a rounded UI box box with radius (appearance's radius) in (appearance's background) on frame
    if appearance's border width > 0.0:
        draw a rounded UI outline box with radius (appearance's radius) width (appearance's border width) in (appearance's border ink) on frame
    if ((((((kind = 2) or (kind = 17)) or (kind = 34)) or (kind = 42)) or (kind = 43)) or text control) or (kind = 46):
        if (kind = 2) or (kind = 43):
            set target to 0.0
            if available and ((view's hot = layout) or ((view's focused = layout) and (view's keyboard focus))):
                set target to 1.0
            set layout's hover to UI value (layout's hover) approaching target at speed 14.0 in view
            if layout's hover > 0.01:
                set tint to appearance's foreground
                draw a rounded UI surface box with radius (appearance's radius) from tint to tint opacity ((layout's hover * 20.4) as an integer) feathered by 0.75 on frame
        if (((kind = 17) or (kind = 34)) or (kind = 39)) or (kind = 50):
            draw UI form decoration for layout in box on frame
        set top to box's y + appearance's padding
        set view's selectable to (((kind != 2) and (kind != 17)) and (kind != 34)) and (kind != 43)
        set view's text source to the address of (layout's text source)
        set clip to the UI form text bounds of layout in box
        set saved to a UI clip restricted to clip in view on frame
        if text control:
            keep the UI caret visible in layout within clip in view
            set top to top - layout's scroll position
        set line to layout's lines
        set colors to @intrinsic("construct", a pointer to UI text color span)
        if text control:
            set value to the UI value for (layout's node) in (view's instance)
            if value's colored text = layout's text source's text:
                set colors to value's colors
        loop while line != @intrinsic("construct", a pointer to UI text line):
            set left to box's x + appearance's padding
            if text control:
                set left to left - layout's text scroll
            if appearance's centered:
                set left to box's x + (box's width - line's width) / 2.0
            if text control:
                if view's selection's composing and (view's selection's caret source = (the address of (layout's text source))):
                    set colors to draw composing UI row line in layout at left (top + line's top + line's ascent) starting with colors on frame
                else:
                    set colors to draw colored UI row line in layout at left (top + line's top + line's ascent) starting with colors on frame
            else:
                draw UI row line in layout at left (top + line's top + line's ascent) on frame
            set line to line's next
        set view's text source to @intrinsic("construct", a pointer to UI text source)
        restore UI clip saved in view on frame
    else if kind = 45:
        set image to UI image from ((the UI value for (layout's node) in (view's instance))'s destination) in view
        set target to UI box at (box's x + appearance's padding) (box's y + appearance's padding) sized (box's width - appearance's padding * 2.0) (box's height - appearance's padding * 2.0)
        if image's status = 2:
            set view's selectable to false
            draw UI text "An error occurred. Check the log." at (target's x) (target's y + 16) with (view's typeface) in (appearance's foreground) on frame
        else:
            draw UI image image in target rounded by (appearance's radius) fitting (appearance's image fit) on frame
    else if kind = 48:
        draw document UI tabs layout in box in view on frame
    else if kind = 49:
        set selected to the selected UI child of (layout's node) in (view's instance)
        set child to layout's first
        loop while child's node != selected:
            set child to child's next
        draw document UI layout child at (box's x) (box's y) in view on frame
    else if kind = 20:
        set handler to the UI handler for (layout's node) in (view's instance) for event 1
        require condition (handler != @intrinsic("construct", a pointer to UI handler)) reporting "The UI surface has no painting callback"
        set visible to the UI intersection of box and (view's clip)
        if (visible's width > 0.0) and (visible's height > 0.0):
            set painting to @intrinsic("construct", UI canvas frame, view's instance, frame, box, view's seconds)
            invoke UI handler handler for (layout's node) in (view's instance) receiving (the address of painting)
    else:
        set child to layout's first
        loop while child != @intrinsic("construct", a pointer to UI layout):
            if child's appearance's sticky = false:
                draw document UI layout child at (box's x) (box's y) in view on frame
            set child to child's next
        set child to layout's first
        loop while child != @intrinsic("construct", a pointer to UI layout):
            if child's appearance's sticky:
                draw document UI layout child at (box's x) (box's y) in view on frame
            set child to child's next

to paint the UI document in {a pointer to UI view:view} on {UI frame:frame}:
    set layout to view's layout
    set layout's scroll position to UI value (layout's scroll position) approaching (layout's scroll target) at speed 18.0 in view
    draw document UI layout layout at 0.0 (0.0 - layout's scroll position) in view on frame
